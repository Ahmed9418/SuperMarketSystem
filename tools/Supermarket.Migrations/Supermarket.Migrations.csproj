<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Design-time only project. It exists so that the EF Core CLI (`dotnet ef migrations add`)
    has a single place to look for the DbContext. Both WPF applications are Windows-only
    targets which the EF tools cannot load on a Linux build agent, therefore the migrations
    are produced from this small net8.0 project and stored in Supermarket.Core/Data/Migrations.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>Supermarket.Migrations</RootNamespace>
    <IsPackable>false</IsPackable>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Supermarket.Core\Supermarket.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.33">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>
