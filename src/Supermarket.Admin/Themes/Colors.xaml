<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- ============================================================
         Brand palette — "Modern Blue" skin.

         Every colour used by the admin shell is declared once here,
         so the whole application can be re-skinned from this block.
         Structure:  Color tokens -> SolidColorBrush wrappers -> metrics.

         Rules of thumb used by the palette:
           * PrimaryBrush      = actions / active navigation / chart series 1
           * PrimaryDarkBrush  = page titles, table headers, pressed states
           * SidebarBrush      = dark navigation rail (white-ish text)
           * *LightBrush       = soft tinted backgrounds for badges & rows
           * AccentBrush       = amber highlight (money, alerts, series 2)
         ============================================================ -->

    <!-- ===== Brand ===== -->
    <Color x:Key="PrimaryColor">#1D4ED8</Color>
    <Color x:Key="PrimaryDarkColor">#1E3A8A</Color>
    <Color x:Key="PrimaryLightColor">#EFF6FF</Color>
    <Color x:Key="PrimaryMidColor">#3B82F6</Color>
    <Color x:Key="AccentColor">#F59E0B</Color>
    <Color x:Key="AccentLightColor">#FEF3C7</Color>

    <!-- ===== Semantic ===== -->
    <Color x:Key="DangerColor">#DC2626</Color>
    <Color x:Key="DangerLightColor">#FEE2E2</Color>
    <Color x:Key="WarningColor">#D97706</Color>
    <Color x:Key="WarningLightColor">#FEF3C7</Color>
    <Color x:Key="WarningDarkColor">#92400E</Color>
    <Color x:Key="SuccessColor">#059669</Color>
    <Color x:Key="SuccessLightColor">#DCFCE7</Color>

    <!-- ===== Surfaces ===== -->
    <Color x:Key="SurfaceColor">#FFFFFF</Color>
    <Color x:Key="CanvasColor">#F4F6FB</Color>
    <Color x:Key="TableStripeColor">#F8FAFC</Color>
    <Color x:Key="BorderColor">#DDE3EE</Color>

    <!-- ===== Dark navigation rail ===== -->
    <Color x:Key="SidebarColor">#0F172A</Color>
    <Color x:Key="SidebarHoverColor">#1E293B</Color>
    <Color x:Key="SidebarPressedColor">#172554</Color>
    <Color x:Key="SidebarDividerColor">#24324A</Color>
    <Color x:Key="SidebarMutedColor">#B6C4DA</Color>

    <!-- ===== Typography colours ===== -->
    <Color x:Key="TextPrimaryColor">#111827</Color>
    <Color x:Key="TextSecondaryColor">#5B6675</Color>

    <!-- ============================================================
         Brushes. Bind to these (never to raw hex) from views.
         ============================================================ -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}" />
    <SolidColorBrush x:Key="PrimaryDarkBrush" Color="{StaticResource PrimaryDarkColor}" />
    <SolidColorBrush x:Key="PrimaryLightBrush" Color="{StaticResource PrimaryLightColor}" />
    <SolidColorBrush x:Key="PrimaryMidBrush" Color="{StaticResource PrimaryMidColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentLightBrush" Color="{StaticResource AccentLightColor}" />

    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
    <SolidColorBrush x:Key="DangerLightBrush" Color="{StaticResource DangerLightColor}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
    <SolidColorBrush x:Key="WarningLightBrush" Color="{StaticResource WarningLightColor}" />
    <SolidColorBrush x:Key="WarningDarkBrush" Color="{StaticResource WarningDarkColor}" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="SuccessLightBrush" Color="{StaticResource SuccessLightColor}" />

    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="CanvasBrush" Color="{StaticResource CanvasColor}" />
    <SolidColorBrush x:Key="TableStripeBrush" Color="{StaticResource TableStripeColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />

    <SolidColorBrush x:Key="SidebarBrush" Color="{StaticResource SidebarColor}" />
    <SolidColorBrush x:Key="SidebarHoverBrush" Color="{StaticResource SidebarHoverColor}" />
    <SolidColorBrush x:Key="SidebarPressedBrush" Color="{StaticResource SidebarPressedColor}" />
    <SolidColorBrush x:Key="SidebarDividerBrush" Color="{StaticResource SidebarDividerColor}" />
    <SolidColorBrush x:Key="SidebarMutedBrush" Color="{StaticResource SidebarMutedColor}" />
    <SolidColorBrush x:Key="SidebarTextBrush" Color="#E8EEF9" />

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />

    <!-- ============================================================
         Typography. "Segoe UI" renders Arabic well on Windows 10/11,
         "Tahoma" is the fallback used by the thermal receipt.
         ============================================================ -->
    <FontFamily x:Key="AppFontFamily">Segoe UI, Tahoma, Arial</FontFamily>
    <FontFamily x:Key="ReceiptFontFamily">Tahoma</FontFamily>

    <sys:Double x:Key="FontSizeSmall">12</sys:Double>
    <sys:Double x:Key="FontSizeNormal">14</sys:Double>
    <sys:Double x:Key="FontSizeMedium">16</sys:Double>
    <sys:Double x:Key="FontSizeLarge">20</sys:Double>
    <sys:Double x:Key="FontSizeTitle">26</sys:Double>

    <!-- Shared metrics -->
    <CornerRadius x:Key="CardCornerRadius">10</CornerRadius>
    <Thickness x:Key="CardPadding">16</Thickness>

</ResourceDictionary>
