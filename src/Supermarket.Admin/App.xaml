<Application x:Class="Supermarket.Admin.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:Supermarket.Admin.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Arabic RTL theme: colors, typography, buttons, grid styles. -->
                <ResourceDictionary Source="/Themes/Colors.xaml" />
                <ResourceDictionary Source="/Themes/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Value converters shared by every view. -->
            <converters:EgpCurrencyConverter x:Key="EgpCurrency" />
            <converters:StockStatusToBrushConverter x:Key="StockStatusBrush" />
            <converters:BooleanToVisibilityConverter x:Key="BoolToVisibility" />
            <converters:InverseBooleanConverter x:Key="InverseBoolean" />
            <converters:EmptyStringToVisibilityConverter x:Key="EmptyStringToVisibility" />
            <converters:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisibility" />
            <converters:NullToVisibilityConverter x:Key="NullToVisibility" />
            <converters:EnumArabicConverter x:Key="EnumArabic" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
