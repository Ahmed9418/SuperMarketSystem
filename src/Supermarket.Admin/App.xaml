<Application x:Class="Supermarket.Admin.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!--
                    Arabic RTL theme, merged in dependency order:
                      1. Colors    — the palette (brushes, font family, metrics)
                      2. Converters— one implementation for both applications (Supermarket.Wpf)
                      3. Controls  — implicit control styles, incl. FlowDirection = RightToLeft
                -->
                <ResourceDictionary Source="/Themes/Colors.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Supermarket.Wpf;component/Themes/Converters.xaml" />
                <ResourceDictionary Source="/Themes/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
