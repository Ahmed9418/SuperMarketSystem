<Window x:Class="Supermarket.Admin.Views.MainWindow"
        Style="{StaticResource AppWindowStyle}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Supermarket.Admin.ViewModels"
        xmlns:views="clr-namespace:Supermarket.Admin.Views"
        Title="نظام إدارة السوبر ماركت - لوحة التحكم"
        Height="820" Width="1440"
        MinHeight="700" MinWidth="1200"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="{StaticResource CanvasBrush}">

    <Window.Resources>
        <!-- View model -> view mapping. Keeps navigation out of the code-behind. -->
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <views:DashboardView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ProductsViewModel}">
            <views:ProductsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SuppliersViewModel}">
            <views:SuppliersView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:LowStockViewModel}">
            <views:LowStockView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:StockMovementsViewModel}">
            <views:StockMovementsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:CatalogViewModel}">
            <views:CatalogView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SalesAnalyticsViewModel}">
            <views:SalesAnalyticsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:UsersViewModel}">
            <views:UsersView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView />
        </DataTemplate>

        <!-- Sidebar navigation button -->
        <Style x:Key="NavButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource BaseButtonStyle}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource SidebarTextBrush}" />
            <Setter Property="HorizontalContentAlignment" Value="Right" />
            <Setter Property="Height" Value="46" />
            <Setter Property="Margin" Value="8,2" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource SidebarHoverBrush}" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource SidebarPressedBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <!-- Right-to-left flow puts the navigation rail on the right: the "first" column. -->
            <ColumnDefinition Width="270" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ================================= Sidebar ================================= -->
        <Border Grid.Column="0" Background="{StaticResource SidebarBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Store identity -->
                <StackPanel Grid.Row="0" Margin="18,26,18,18">
                    <TextBlock Text="{Binding StoreName}"
                               FontSize="21" FontWeight="Bold" Foreground="White" />
                    <TextBlock Text="لوحة تحكم الإدارة"
                               FontSize="12" Margin="0,4,0,0"
                               Foreground="{StaticResource SidebarTextBrush}" Opacity="0.8" />
                </StackPanel>

                <!-- Navigation -->
                <StackPanel Grid.Row="1" Margin="0,6,0,0">
                    <TextBlock Text="القوائم الرئيسية" FontSize="11"
                               Foreground="{StaticResource SidebarTextBrush}" Opacity="0.75"
                               Margin="22,6,22,6" />

                    <Button Content="📊   لوحة التحكم" Style="{StaticResource NavButtonStyle}"
                            Command="{Binding NavigateToDashboardCommand}" />
                    <Button Content="📦   المنتجات" Style="{StaticResource NavButtonStyle}"
                            Command="{Binding NavigateToProductsCommand}"
                            Visibility="{Binding CanViewProducts, Converter={StaticResource BoolToVisibility}}" />
                    <Button Content="⚠   نواقص المخزون" Style="{StaticResource NavButtonStyle}"
                            Command="{Binding NavigateToLowStockCommand}"
                            Visibility="{Binding CanViewStock, Converter={StaticResource BoolToVisibility}}" />
                    <Button Content="🔁   حركة المخزون" Style="{StaticResource NavButtonStyle}"
                            Command="{Binding NavigateToStockMovementsCommand}"
                            Visibility="{Binding CanViewStock, Converter={StaticResource BoolToVisibility}}" />
                    <Button Content="🏷   الأقسام ووحدات القياس" Style="{StaticResource NavButtonStyle}"
                            Command="{Binding NavigateToCatalogCommand}"
                            Visibility="{Binding CanViewCatalog, Converter={StaticResource BoolToVisibility}}" />
                    <Button Content="🚚   الموردون" Style="{StaticResource NavButtonStyle}"
                            Command="{Binding NavigateToSuppliersCommand}"
                            Visibility="{Binding CanViewSuppliers, Converter={StaticResource BoolToVisibility}}" />

                    <Rectangle Height="1" Fill="{StaticResource SidebarDividerBrush}" Margin="18,14" />

                    <Button Content="📈   المبيعات والتحليلات" Style="{StaticResource NavButtonStyle}"
                            Command="{Binding NavigateToAnalyticsCommand}"
                            Visibility="{Binding CanViewReports, Converter={StaticResource BoolToVisibility}}" />
                    <Button Content="👥   المستخدمون والصلاحيات" Style="{StaticResource NavButtonStyle}"
                            Command="{Binding NavigateToUsersCommand}"
                            Visibility="{Binding CanViewUsers, Converter={StaticResource BoolToVisibility}}" />
                    <Button Content="⚙   الإعدادات" Style="{StaticResource NavButtonStyle}"
                            Command="{Binding NavigateToSettingsCommand}"
                            Visibility="{Binding CanViewSettings, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>

                <!-- Signed-in operator -->
                <Border Grid.Row="2" Background="{StaticResource SidebarPressedBrush}" Padding="16,12" Margin="0,10,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{Binding DisplayName}" Foreground="White" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding RoleName}" Foreground="{StaticResource SidebarMutedBrush}"
                                       FontSize="11" Margin="0,2,0,0" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="خروج"
                                Style="{StaticResource NavButtonStyle}"
                                Height="30" Width="62" Padding="0" FontSize="12"
                                Command="{Binding SignOutCommand}" />
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- ================================= Content ================================= -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Header bar -->
            <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}" Padding="24,14"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{Binding CurrentPageTitle}" FontSize="20" FontWeight="Bold"
                                   Foreground="{StaticResource PrimaryDarkBrush}" />
                        <TextBlock Text="{Binding StoreName}" FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Two runs instead of a StringFormat so the date keeps its Latin digits. -->
                        <TextBlock Foreground="{StaticResource TextSecondaryBrush}">
                            <Run Text="اليوم:" />
                            <Run Text="{Binding TodayText, Mode=OneWay}" />
                        </TextBlock>
                        <ProgressBar Width="90" Height="5" Margin="16,0,0,0"
                                     IsIndeterminate="True"
                                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}"
                                     Foreground="{StaticResource PrimaryBrush}"
                                     BorderThickness="0" Background="Transparent" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Active page -->
            <ContentControl Grid.Row="1" Content="{Binding Navigation.CurrentViewModel}" Margin="16" />
        </Grid>
    </Grid>
</Window>
