<UserControl x:Class="Supermarket.Admin.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <Style x:Key="SettingsLabelStyle" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource FieldLabelTextStyle}">
            <Setter Property="Margin" Value="0,10,0,4" />
        </Style>
    </UserControl.Resources>

    <TabControl>
        <TabItem Header="الإعدادات العامة والطباعة">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Store identity -->
                    <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" Margin="0,0,12,12">
                        <StackPanel>
                            <TextBlock Text="بيانات المتجر (تُطبع على الإيصال)" Style="{StaticResource CardTitleTextStyle}" />

                            <TextBlock Text="اسم المتجر *" Style="{StaticResource SettingsLabelStyle}" />
                            <TextBox Text="{Binding StoreName, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock Text="العنوان" Style="{StaticResource SettingsLabelStyle}" />
                            <TextBox Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock Text="رقم الهاتف" Style="{StaticResource SettingsLabelStyle}" />
                            <TextBox Style="{StaticResource LatinInputStyle}"
                                     Text="{Binding PhoneNumber, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock Text="الرقم الضريبي" Style="{StaticResource SettingsLabelStyle}" />
                            <TextBox Style="{StaticResource LatinInputStyle}"
                                     Text="{Binding TaxNumber, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock Text="رسالة أسفل الإيصال" Style="{StaticResource SettingsLabelStyle}" />
                            <TextBox Text="{Binding ReceiptFooterMessage, UpdateSourceTrigger=PropertyChanged}"
                                     Height="60" AcceptsReturn="True" TextWrapping="Wrap"
                                     VerticalContentAlignment="Top" />

                            <!-- Store Logo -->
                            <TextBlock Text="شعار المتجر (اللوجو)" Style="{StaticResource SettingsLabelStyle}" Margin="0,14,0,4" />
                            <Border Background="{StaticResource CanvasBrush}" BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Preview Image or Placeholder -->
                                    <Border Grid.Column="0" Width="90" Height="70" Background="White"
                                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                            CornerRadius="6" Margin="0,0,12,0" VerticalAlignment="Center">
                                        <Grid>
                                            <Image Source="{Binding LogoPath}" Stretch="Uniform" Margin="4">
                                                <Image.Style>
                                                    <Style TargetType="{x:Type Image}">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasLogo}" Value="False">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Image.Style>
                                            </Image>
                                            <TextBlock Text="لا يوجد شعار" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="{x:Type TextBlock}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasLogo}" Value="False">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                    </Border>

                                    <!-- Logo Actions -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="يُطبع الشعار في أعلى الإيصالات والفواتير (80 مم / A4 / A5)"
                                                   FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,8" />
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="📁 اختيار شعار (لوجو)..." Width="150" Height="34" Margin="0,0,8,0"
                                                    Style="{StaticResource SecondaryButtonStyle}"
                                                    Command="{Binding ChooseLogoCommand}" IsEnabled="{Binding CanEdit}" />
                                            <Button Content="🗑 حذف الشعار" Width="110" Height="34"
                                                    Command="{Binding RemoveLogoCommand}" IsEnabled="{Binding CanEdit}">
                                                <Button.Style>
                                                    <Style TargetType="{x:Type Button}" BasedOn="{StaticResource DangerButtonStyle}">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasLogo}" Value="False">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Printing & fiscal -->
                    <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="الطباعة والضريبة" Style="{StaticResource CardTitleTextStyle}" />

                            <!-- Paper size selector: 80mm, A4, A5 -->
                            <TextBlock Text="نوع الفاتورة / حجم الورق المطلوب *" Style="{StaticResource SettingsLabelStyle}" />
                            <ComboBox ItemsSource="{Binding PaperSizes}"
                                      SelectedItem="{Binding SelectedPaperSizeOption}"
                                      DisplayMemberPath="Title" Height="36" />
                            <TextBlock Text="{Binding SelectedPaperSizeOption.Description}" FontSize="11"
                                       Foreground="{StaticResource PrimaryBrush}" FontWeight="SemiBold" Margin="0,3,0,6" />

                            <!-- Printer selector -->
                            <TextBlock Text="اسم طابعة الفواتير والإيصالات في ويندوز" Style="{StaticResource SettingsLabelStyle}" />
                            <ComboBox ItemsSource="{Binding InstalledPrinters}"
                                      Text="{Binding ReceiptPrinterName, UpdateSourceTrigger=PropertyChanged}"
                                      IsEditable="True" Height="36" />
                            <TextBlock Text="اختر الطابعة من القائمة أو اتركها فارغة لاستخدام الطابعة الافتراضية للويندوز" FontSize="11"
                                       Foreground="{StaticResource TextSecondaryBrush}" Margin="0,3,0,0" />

                            <!-- Line width for thermal 80mm -->
                            <StackPanel Margin="0,10,0,0">
                                <StackPanel.Style>
                                    <Style TargetType="{x:Type StackPanel}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsThermalSelected}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Text="عرض سطر الإيصال الحراري (حرف)" Style="{StaticResource SettingsLabelStyle}" Margin="0,0,0,4" />
                                <ComboBox ItemsSource="{Binding LineWidths}" SelectedItem="{Binding ReceiptLineWidth}" Height="36" />
                                <TextBlock Text="{Binding LineWidthHint}" FontSize="11"
                                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,3,0,0" />
                            </StackPanel>

                            <!-- Fiscal settings -->
                            <TextBlock Text="نسبة ضريبة القيمة المضافة الافتراضية %"
                                       Style="{StaticResource SettingsLabelStyle}" />
                            <TextBox Style="{StaticResource NumericInputStyle}"
                                     Text="{Binding DefaultVatRate, UpdateSourceTrigger=PropertyChanged, StringFormat='{}{0:N2}'}" />

                            <CheckBox Content="الأسعار المعروضة تشمل الضريبة"
                                      IsChecked="{Binding PricesIncludeVat}" Margin="0,12,0,0" />
                            <CheckBox Content="إنشاء البار كود تلقائياً عند تركه فارغاً"
                                      IsChecked="{Binding AutoGenerateBarcode}" Margin="0,6,0,0" />

                            <TextBlock Text="عدد الخانات العشرية في الإيصال"
                                       Style="{StaticResource SettingsLabelStyle}" />
                            <TextBox Style="{StaticResource NumericInputStyle}" MaxLength="1"
                                     Text="{Binding DecimalPlaces, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- ==================== Invoice Preview Section (تحت الإعدادات) ==================== -->
                <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,12"
                        Visibility="{Binding IsPreviewVisible, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <!-- Header of the Preview Card -->
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📄 شكل وتصميم الفاتورة (معاينة حية)" Style="{StaticResource CardTitleTextStyle}" />
                                    <Border Background="{StaticResource PrimaryLightBrush}" CornerRadius="12" Padding="10,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding SelectedPaperSizeOption.Title}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}" />
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="هذا هو الشكل النهائي الحقيقي الذي سيحصل عليه العميل عند الطباعة وفقاً لإعداداتك الحالية"
                                           FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="⛶ تكبير في نافذة مستقلة" Height="32" Padding="12,0" Margin="0,0,8,0"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Command="{Binding OpenPreviewWindowCommand}" />
                                <Button Content="✕ إغلاق المعاينة" Height="32" Padding="12,0"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Command="{Binding TogglePreviewCommand}" />
                            </StackPanel>
                        </Grid>

                        <!-- Preview Canvas with background surface -->
                        <Border Background="{StaticResource CanvasBrush}" BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="24" MinHeight="350">
                            <Grid HorizontalAlignment="Center">

                                <!-- 1) 80mm Thermal Receipt Layout -->
                                <Border Background="White" Width="360" CornerRadius="4" Padding="16"
                                        BorderBrush="#CBD5E1" BorderThickness="1"
                                        Visibility="{Binding Is80mm, Converter={StaticResource BoolToVisibility}}">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="12" ShadowDepth="3" Opacity="0.12" Direction="270" />
                                    </Border.Effect>
                                    <StackPanel>
                                        <!-- Zigzag / perforated top styling -->
                                        <Border Height="3" Background="#E2E8F0" Margin="-16,-16,-16,12" />

                                        <!-- Logo (if HasLogo) -->
                                        <Image Source="{Binding LogoPath}" MaxWidth="140" MaxHeight="60" Stretch="Uniform"
                                               HorizontalAlignment="Center" Margin="0,0,0,8">
                                            <Image.Style>
                                                <Style TargetType="{x:Type Image}">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasLogo}" Value="False">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Image.Style>
                                        </Image>

                                        <!-- Store Header -->
                                        <TextBlock Text="{Binding StoreName}" FontSize="16" FontWeight="Bold"
                                                   TextAlignment="Center" HorizontalAlignment="Center" />
                                        <TextBlock Text="{Binding Address}" FontSize="11" Foreground="#475569"
                                                   TextAlignment="Center" HorizontalAlignment="Center" Margin="0,2,0,0">
                                            <TextBlock.Style>
                                                <Style TargetType="{x:Type TextBlock}">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Address}" Value="">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Address}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text="{Binding PhoneNumber, StringFormat='الهاتف: {0}'}" FontSize="11" Foreground="#475569"
                                                   TextAlignment="Center" HorizontalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="{x:Type TextBlock}">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding PhoneNumber}" Value="">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding PhoneNumber}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text="{Binding TaxNumber, StringFormat='الرقم الضريبي: {0}'}" FontSize="11" Foreground="#475569"
                                                   TextAlignment="Center" HorizontalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="{x:Type TextBlock}">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding TaxNumber}" Value="">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding TaxNumber}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <!-- Divider -->
                                        <TextBlock Text="------------------------------------------------" FontSize="11"
                                                   Foreground="#94A3B8" TextAlignment="Center" Margin="0,6,0,6" />

                                        <!-- Receipt Meta -->
                                        <Grid Margin="0,0,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="فاتورة ضريبية مبسطة" FontSize="11" FontWeight="SemiBold" />
                                            <TextBlock Grid.Column="1" Text="رقم: 000124" FontSize="11" />
                                        </Grid>
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding CurrentDatePreview}" FontSize="10" Foreground="#64748B" />
                                            <TextBlock Grid.Column="1" Text="كاشير: أحمد عبد الرحمن" FontSize="10" Foreground="#64748B" />
                                        </Grid>

                                        <!-- Items Header -->
                                        <TextBlock Text="================================================" FontSize="10"
                                                   Foreground="#94A3B8" TextAlignment="Center" Margin="0,0,0,4" />
                                        <Grid Margin="0,0,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="50" />
                                                <ColumnDefinition Width="70" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="الصنف" FontSize="11" FontWeight="Bold" />
                                            <TextBlock Grid.Column="1" Text="الكمية" FontSize="11" FontWeight="Bold" TextAlignment="Center" />
                                            <TextBlock Grid.Column="2" Text="الإجمالي" FontSize="11" FontWeight="Bold" TextAlignment="Left" />
                                        </Grid>
                                        <TextBlock Text="------------------------------------------------" FontSize="10"
                                                   Foreground="#94A3B8" TextAlignment="Center" Margin="0,0,0,4" />

                                        <!-- Sample Items -->
                                        <Grid Margin="0,2,0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="50" />
                                                <ColumnDefinition Width="70" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="أرز مصري فاخر 1 كجم" FontSize="11" FontWeight="Medium" />
                                                <TextBlock Text="2 × 33.00 ج.م" FontSize="9" Foreground="#64748B" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="2" FontSize="11" TextAlignment="Center" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2" Text="66.00" FontSize="11" FontWeight="SemiBold" TextAlignment="Left" VerticalAlignment="Center" />
                                        </Grid>

                                        <Grid Margin="0,2,0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="50" />
                                                <ColumnDefinition Width="70" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="زيت عباد شمس عافية 1 لتر" FontSize="11" FontWeight="Medium" />
                                                <TextBlock Text="1 × 78.00 ج.م" FontSize="9" Foreground="#64748B" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="1" FontSize="11" TextAlignment="Center" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2" Text="78.00" FontSize="11" FontWeight="SemiBold" TextAlignment="Left" VerticalAlignment="Center" />
                                        </Grid>

                                        <Grid Margin="0,2,0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="50" />
                                                <ColumnDefinition Width="70" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="جبنة رومي طازجة (كيلو)" FontSize="11" FontWeight="Medium" />
                                                <TextBlock Text="0.5 × 285.00 ج.م" FontSize="9" Foreground="#64748B" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="0.50" FontSize="11" TextAlignment="Center" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2" Text="142.50" FontSize="11" FontWeight="SemiBold" TextAlignment="Left" VerticalAlignment="Center" />
                                        </Grid>

                                        <TextBlock Text="================================================" FontSize="10"
                                                   Foreground="#94A3B8" TextAlignment="Center" Margin="0,6,0,6" />

                                        <!-- Totals -->
                                        <Grid Margin="0,1,0,1">
                                            <TextBlock Text="المجموع قبل الضريبة:" FontSize="11" />
                                            <TextBlock Text="251.32 ج.م" FontSize="11" HorizontalAlignment="Left" />
                                        </Grid>
                                        <Grid Margin="0,1,0,1">
                                            <TextBlock Text="{Binding DefaultVatRate, StringFormat='ضريبة القيمة المضافة ({0:N0}%):'}" FontSize="11" />
                                            <TextBlock Text="35.18 ج.م" FontSize="11" HorizontalAlignment="Left" />
                                        </Grid>
                                        <Border Background="#F1F5F9" Padding="6,4" Margin="0,4,0,4" CornerRadius="4">
                                            <Grid>
                                                <TextBlock Text="الإجمالي النهائي:" FontSize="13" FontWeight="Bold" />
                                                <TextBlock Text="286.50 ج.م" FontSize="13" FontWeight="Bold" Foreground="{StaticResource PrimaryDarkBrush}" HorizontalAlignment="Left" />
                                            </Grid>
                                        </Border>

                                        <TextBlock Text="طريقة الدفع: نقدي (مدفوع: 300.00 | الباقي: 13.50)" FontSize="10" Foreground="#64748B" Margin="0,2,0,6" />

                                        <!-- Receipt Footer Message -->
                                        <TextBlock Text="{Binding ReceiptFooterMessage}" FontSize="11" FontWeight="Medium"
                                                   TextAlignment="Center" TextWrapping="Wrap" Margin="0,6,0,8" />

                                        <!-- Barcode Simulation -->
                                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="4" Padding="6" Margin="0,4,0,0">
                                            <StackPanel HorizontalAlignment="Center">
                                                <TextBlock Text="||| | ||||| || |||| |||||| |||| | |||||| |||" FontFamily="Courier New" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" />
                                                <TextBlock Text="6223000011302" FontSize="9" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                            </StackPanel>
                                        </Border>

                                        <!-- Bottom Perforation -->
                                        <Border Height="3" Background="#E2E8F0" Margin="-16,14,-16,-16" />
                                    </StackPanel>
                                </Border>

                                <!-- 2) A4 / A5 Tax Invoice Layout -->
                                <Border Background="White" CornerRadius="4" Padding="28"
                                        BorderBrush="#CBD5E1" BorderThickness="1"
                                        Visibility="{Binding IsThermalSelected, Converter={StaticResource BoolToVisibilityInverse}}">
                                    <Border.Style>
                                        <Style TargetType="{x:Type Border}">
                                            <Setter Property="Width" Value="720" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsA5}" Value="True">
                                                    <Setter Property="Width" Value="540" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="12" ShadowDepth="3" Opacity="0.12" Direction="270" />
                                    </Border.Effect>
                                    <StackPanel>
                                        <!-- Header with Store Info & Logo -->
                                        <Grid Margin="0,0,0,16">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Store Info -->
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding StoreName}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" />
                                                <TextBlock Text="{Binding Address, StringFormat='العنوان: {0}'}" FontSize="11" Margin="0,3,0,0" Foreground="#334155" />
                                                <TextBlock Text="{Binding PhoneNumber, StringFormat='الهاتف: {0}'}" FontSize="11" Margin="0,2,0,0" Foreground="#334155" />
                                                <TextBlock Text="{Binding TaxNumber, StringFormat='الرقم الضريبي: {0}'}" FontSize="11" Margin="0,2,0,0" Foreground="#334155" />
                                            </StackPanel>

                                            <!-- Logo -->
                                            <Border Grid.Column="1" VerticalAlignment="Center">
                                                <Image Source="{Binding LogoPath}" MaxWidth="150" MaxHeight="80" Stretch="Uniform">
                                                    <Image.Style>
                                                        <Style TargetType="{x:Type Image}">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasLogo}" Value="False">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Image.Style>
                                                </Image>
                                            </Border>
                                        </Grid>

                                        <Separator Background="{StaticResource BorderBrush}" Margin="0,0,0,14" />

                                        <!-- Document Meta Banner -->
                                        <Border Background="{StaticResource PrimaryLightBrush}" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,14">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="نوع المستند" FontSize="10" Foreground="#64748B" />
                                                    <TextBlock Text="{Binding SelectedPaperSizeOption.Title}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource PrimaryDarkBrush}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="رقم الفاتورة والتاريخ" FontSize="10" Foreground="#64748B" />
                                                    <TextBlock Text="{Binding CurrentDatePreview, StringFormat='INV-2026-00124 | {0}'}" FontSize="11" FontWeight="SemiBold" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="العميل / الدفع" FontSize="10" Foreground="#64748B" />
                                                    <TextBlock Text="عميل نقدي عام  (نقداً)" FontSize="11" FontWeight="SemiBold" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>

                                        <!-- Items Table -->
                                        <Border BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4" Margin="0,0,0,14">
                                            <StackPanel>
                                                <!-- Table Header -->
                                                <Border Background="#F1F5F9" Padding="8,6" BorderBrush="#CBD5E1" BorderThickness="0,0,0,1">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="36" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="60" />
                                                            <ColumnDefinition Width="80" />
                                                            <ColumnDefinition Width="90" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="#" FontWeight="Bold" FontSize="11" TextAlignment="Center" />
                                                        <TextBlock Grid.Column="1" Text="الصنف والوصف" FontWeight="Bold" FontSize="11" />
                                                        <TextBlock Grid.Column="2" Text="الكمية" FontWeight="Bold" FontSize="11" TextAlignment="Center" />
                                                        <TextBlock Grid.Column="3" Text="سعر الوحدة" FontWeight="Bold" FontSize="11" TextAlignment="Left" />
                                                        <TextBlock Grid.Column="4" Text="الإجمالي" FontWeight="Bold" FontSize="11" TextAlignment="Left" />
                                                    </Grid>
                                                </Border>

                                                <!-- Row 1 -->
                                                <Border Padding="8,6" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="36" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="60" />
                                                            <ColumnDefinition Width="80" />
                                                            <ColumnDefinition Width="90" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="1" FontSize="11" TextAlignment="Center" />
                                                        <TextBlock Grid.Column="1" Text="أرز مصري فاخر 1 كجم" FontSize="11" FontWeight="Medium" />
                                                        <TextBlock Grid.Column="2" Text="2.00" FontSize="11" TextAlignment="Center" />
                                                        <TextBlock Grid.Column="3" Text="33.00 ج.م" FontSize="11" TextAlignment="Left" />
                                                        <TextBlock Grid.Column="4" Text="66.00 ج.م" FontSize="11" FontWeight="SemiBold" TextAlignment="Left" />
                                                    </Grid>
                                                </Border>

                                                <!-- Row 2 -->
                                                <Border Padding="8,6" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Background="#F8FAFC">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="36" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="60" />
                                                            <ColumnDefinition Width="80" />
                                                            <ColumnDefinition Width="90" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="2" FontSize="11" TextAlignment="Center" />
                                                        <TextBlock Grid.Column="1" Text="زيت عباد شمس عافية 1 لتر" FontSize="11" FontWeight="Medium" />
                                                        <TextBlock Grid.Column="2" Text="1.00" FontSize="11" TextAlignment="Center" />
                                                        <TextBlock Grid.Column="3" Text="78.00 ج.م" FontSize="11" TextAlignment="Left" />
                                                        <TextBlock Grid.Column="4" Text="78.00 ج.م" FontSize="11" FontWeight="SemiBold" TextAlignment="Left" />
                                                    </Grid>
                                                </Border>

                                                <!-- Row 3 -->
                                                <Border Padding="8,6">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="36" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="60" />
                                                            <ColumnDefinition Width="80" />
                                                            <ColumnDefinition Width="90" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="3" FontSize="11" TextAlignment="Center" />
                                                        <TextBlock Grid.Column="1" Text="جبنة رومي طازجة (كيلو)" FontSize="11" FontWeight="Medium" />
                                                        <TextBlock Grid.Column="2" Text="0.50" FontSize="11" TextAlignment="Center" />
                                                        <TextBlock Grid.Column="3" Text="285.00 ج.م" FontSize="11" TextAlignment="Left" />
                                                        <TextBlock Grid.Column="4" Text="142.50 ج.م" FontSize="11" FontWeight="SemiBold" TextAlignment="Left" />
                                                    </Grid>
                                                </Border>
                                            </StackPanel>
                                        </Border>

                                        <!-- Summary Totals -->
                                        <Border HorizontalAlignment="Left" Width="260" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="12,8">
                                            <StackPanel>
                                                <Grid Margin="0,1">
                                                    <TextBlock Text="الإجمالي قبل الضريبة:" FontSize="11" />
                                                    <TextBlock Text="251.32 ج.م" FontSize="11" HorizontalAlignment="Left" />
                                                </Grid>
                                                <Grid Margin="0,1">
                                                    <TextBlock Text="{Binding DefaultVatRate, StringFormat='ضريبة القيمة المضافة ({0:N0}%):'}" FontSize="11" />
                                                    <TextBlock Text="35.18 ج.م" FontSize="11" HorizontalAlignment="Left" />
                                                </Grid>
                                                <Separator Margin="0,4" />
                                                <Grid Margin="0,1">
                                                    <TextBlock Text="صافي الفاتورة الإجمالي:" FontSize="13" FontWeight="Bold" />
                                                    <TextBlock Text="286.50 ج.م" FontSize="13" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Left" />
                                                </Grid>
                                            </StackPanel>
                                        </Border>

                                        <!-- Footer -->
                                        <TextBlock Text="{Binding ReceiptFooterMessage}" FontSize="11" Foreground="#475569" TextAlignment="Center" Margin="0,20,0,0" />
                                    </StackPanel>
                                </Border>

                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardBorderStyle}">
                    <StackPanel>
                        <TextBlock Text="معلومات النظام" Style="{StaticResource CardTitleTextStyle}" />
                        <TextBlock Margin="0,8,0,0" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}">
                            <Run Text="الإصدار:" />
                            <Run Text="1.6.0 - طباعة الفواتير الذكية" />
                            <Run Text="   |   أحجام الفواتير المدعومة: 80mm حراري، A4 قياسية، A5 مدمجة" />
                        </TextBlock>
                        <TextBlock Margin="0,4,0,0" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                                   TextWrapping="Wrap"
                                   Text="أي تعديل على اسم المتجر أو الشعار أو نوع الفاتورة يظهر فوراً على الفواتير والإيصالات التالية." />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Bottom Actions Bar -->
        <Border Grid.Row="1" Margin="0,12,0,-12" Padding="14,8" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="{Binding StatusMessage}" FontSize="12"
                           VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" />

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="{Binding PreviewToggleText}" Width="170" Height="38" Margin="0,0,8,0"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding TogglePreviewCommand}" />
                    <Button Content="💾 حفظ الإعدادات" Width="150" Height="38" Margin="0,0,8,0"
                            Command="{Binding SaveCommand}" IsEnabled="{Binding CanEdit}" />
                    <Button Content="🔄 إعادة التحميل" Width="130" Height="38"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding LoadCommand}" />
                </StackPanel>
            </Grid>
        </Border>
            </Grid>
        </TabItem>

        <!-- Tab 2: Database Backup & Recovery -->
        <TabItem Header="النسخ الاحتياطي واستعادة البيانات">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,16,0,24">

                    <!-- 1. Status Card (بطاقة حالة النظام والقاعدة) -->
                    <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="حالة النظام وقاعدة البيانات" Style="{StaticResource CardTitleTextStyle}" />

                            <Grid Margin="0,4,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="1.5*" />
                                </Grid.ColumnDefinitions>

                                <!-- Server and Database Name -->
                                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                    <TextBlock Text="خادم قاعدة البيانات:" Style="{StaticResource FieldLabelTextStyle}" />
                                    <TextBlock Text="{Binding DatabaseServerName}" FontWeight="SemiBold"
                                               Foreground="{StaticResource PrimaryDarkBrush}" />

                                    <TextBlock Text="اسم قاعدة البيانات:" Style="{StaticResource FieldLabelTextStyle}" Margin="0,10,0,0" />
                                    <TextBlock Text="{Binding DatabaseCatalogName}" FontWeight="SemiBold"
                                               Foreground="{StaticResource PrimaryDarkBrush}" />
                                </StackPanel>

                                <!-- Last Backup Time -->
                                <StackPanel Grid.Column="1" Margin="0,0,12,0">
                                    <TextBlock Text="تاريخ آخر نسخة احتياطية:" Style="{StaticResource FieldLabelTextStyle}" />
                                    <TextBlock Text="{Binding LastBackupDisplayTime}" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}" />
                                </StackPanel>

                                <!-- Status Message -->
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="رسالة الحالة الحالية:" Style="{StaticResource FieldLabelTextStyle}" />
                                    <TextBlock Text="{Binding BackupStatusMessage}" TextWrapping="Wrap"
                                               Foreground="{StaticResource TextSecondaryBrush}" />
                                </StackPanel>
                            </Grid>

                            <!-- Indeterminate Progress Bar for busy operations -->
                            <ProgressBar Height="4" Margin="0,10,0,0" IsIndeterminate="True"
                                         Visibility="{Binding IsBackupBusy, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                    </Border>

                    <!-- 2. Manual Section Card (النسخ الاحتياطي والاستعادة اليدوية) -->
                    <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="النسخ الاحتياطي والاستعادة اليدوية" Style="{StaticResource CardTitleTextStyle}" />
                            <TextBlock Text="إنشاء نسخة احتياطية فورية وحفظها في المسار المفضل لديك، أو استعادة قاعدة البيانات من نسخة سابقة."
                                       Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,14" TextWrapping="Wrap" />

                            <StackPanel Orientation="Horizontal">
                                <Button Content="💾 إنشاء نسخة احتياطية الآن"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Command="{Binding BackupNowCommand}"
                                        Width="230" Height="40" Margin="0,0,12,0"
                                        IsEnabled="{Binding IsBackupBusy, Converter={StaticResource InverseBoolean}}" />

                                <Button Content="⚠️ استعادة قاعدة البيانات"
                                        Style="{StaticResource DangerButtonStyle}"
                                        Command="{Binding RestoreDatabaseCommand}"
                                        Width="210" Height="40"
                                        IsEnabled="{Binding IsBackupBusy, Converter={StaticResource InverseBoolean}}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- 3. Auto-Backup Section Card (النسخ الاحتياطي التلقائي المجدول) -->
                    <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="النسخ الاحتياطي التلقائي المجدول" Style="{StaticResource CardTitleTextStyle}" />
                            <TextBlock Text="تفعيل النسخ الاحتياطي الدوري في الخلفية لحماية بيانات النظام دون الحاجة لتدخل يدوي."
                                       Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,14" TextWrapping="Wrap" />

                            <!-- ToggleSwitch for Auto-Backup -->
                            <CheckBox Content="التسجيل الاحتياطي التلقائي"
                                      Style="{StaticResource ToggleSwitchStyle}"
                                      IsChecked="{Binding IsAutoBackupEnabled, Mode=TwoWay}"
                                      Margin="0,0,0,16" />

                            <!-- Frequency ComboBox -->
                            <TextBlock Text="تكرار النسخ الاحتياطي:" Style="{StaticResource FieldLabelTextStyle}" />
                            <ComboBox ItemsSource="{Binding BackupFrequencies}"
                                      SelectedItem="{Binding SelectedFrequency, Mode=TwoWay}"
                                      Width="220" HorizontalAlignment="Left" Height="38" Margin="0,0,0,16" />

                            <!-- Destination Folder Path & Browse Combo -->
                            <TextBlock Text="مجلد حفظ النسخ الاحتياطية التلقائية:" Style="{StaticResource FieldLabelTextStyle}" />
                            <Grid Margin="0,0,0,18">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBox Grid.Column="0"
                                         Style="{StaticResource LatinInputStyle}"
                                         Text="{Binding AutoBackupFolderPath, UpdateSourceTrigger=PropertyChanged}"
                                         Margin="0,0,10,0" />

                                <Button Grid.Column="1"
                                        Content="📁 استعراض..."
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Command="{Binding BrowseBackupFolderCommand}"
                                        Width="120" Height="38" />
                            </Grid>

                            <!-- Save Auto-backup settings button -->
                            <Button Content="💾 حفظ إعدادات النسخ التلقائي"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Command="{Binding SaveAutoBackupSettingsCommand}"
                                    HorizontalAlignment="Left" Width="240" Height="40"
                                    IsEnabled="{Binding IsBackupBusy, Converter={StaticResource InverseBoolean}}" />
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>
        </TabItem>
    </TabControl>
</UserControl>
