<UserControl x:Class="Supermarket.Admin.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Store identity -->
                    <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" Margin="0,0,12,12">
                        <StackPanel>
                            <TextBlock Text="بيانات المتجر (تُطبع على الإيصال)" Style="{StaticResource CardTitleTextStyle}" />

                            <TextBlock Text="اسم المتجر" Style="{StaticResource FieldLabelTextStyle}" Margin="0,10,0,0" />
                            <TextBox Text="{Binding StoreName, UpdateSourceTrigger=PropertyChanged}" Height="36" />

                            <TextBlock Text="العنوان" Style="{StaticResource FieldLabelTextStyle}" Margin="0,10,0,0" />
                            <TextBox Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}" Height="36" />

                            <TextBlock Text="رقم الهاتف" Style="{StaticResource FieldLabelTextStyle}" Margin="0,10,0,0" />
                            <TextBox Text="{Binding PhoneNumber, UpdateSourceTrigger=PropertyChanged}" Height="36"
                                     FlowDirection="LeftToRight" />

                            <TextBlock Text="الرقم الضريبي" Style="{StaticResource FieldLabelTextStyle}" Margin="0,10,0,0" />
                            <TextBox Text="{Binding TaxNumber, UpdateSourceTrigger=PropertyChanged}" Height="36"
                                     FlowDirection="LeftToRight" />

                            <TextBlock Text="رسالة أسفل الإيصال" Style="{StaticResource FieldLabelTextStyle}" Margin="0,10,0,0" />
                            <TextBox Text="{Binding ReceiptFooterMessage, UpdateSourceTrigger=PropertyChanged}"
                                     Height="70" AcceptsReturn="True" TextWrapping="Wrap"
                                     VerticalContentAlignment="Top" />
                        </StackPanel>
                    </Border>

                    <!-- Printing & fiscal -->
                    <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="الطباعة والضريبة" Style="{StaticResource CardTitleTextStyle}" />

                            <TextBlock Text="اسم طابعة الإيصالات في ويندوز" Style="{StaticResource FieldLabelTextStyle}" Margin="0,10,0,0" />
                            <TextBox Text="{Binding ReceiptPrinterName, UpdateSourceTrigger=PropertyChanged}" Height="36"
                                     FlowDirection="LeftToRight" />
                            <TextBlock Text="اتركه فارغاً لاستخدام الطابعة الافتراضية" FontSize="11"
                                       Foreground="{StaticResource TextSecondaryBrush}" Margin="0,3,0,0" />

                            <TextBlock Text="عرض سطر الإيصال (حرف)" Style="{StaticResource FieldLabelTextStyle}" Margin="0,10,0,0" />
                            <ComboBox ItemsSource="{Binding LineWidths}" SelectedItem="{Binding ReceiptLineWidth}" Height="36" />
                            <TextBlock Text="{Binding LineWidthHint}" FontSize="11"
                                       Foreground="{StaticResource TextSecondaryBrush}" Margin="0,3,0,0" />

                            <TextBlock Text="نسبة ضريبة القيمة المضافة الافتراضية %" Style="{StaticResource FieldLabelTextStyle}" Margin="0,10,0,0" />
                            <TextBox Text="{Binding DefaultVatRate, UpdateSourceTrigger=PropertyChanged, StringFormat='{}{0:N2}'}"
                                     Height="36" FlowDirection="LeftToRight" />

                            <CheckBox Content="الأسعار المعروضة تشمل الضريبة" IsChecked="{Binding PricesIncludeVat}" Margin="0,12,0,0" />
                            <CheckBox Content="إنشاء البار كود تلقائياً عند تركه فارغاً" IsChecked="{Binding AutoGenerateBarcode}" Margin="0,8,0,0" />

                            <TextBlock Text="عدد الخانات العشرية في الإيصال" Style="{StaticResource FieldLabelTextStyle}" Margin="0,10,0,0" />
                            <TextBox Text="{Binding DecimalPlaces, UpdateSourceTrigger=PropertyChanged}" Height="36"
                                     FlowDirection="LeftToRight" MaxLength="1" />
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Style="{StaticResource CardBorderStyle}">
                    <StackPanel>
                        <TextBlock Text="معلومات النظام" Style="{StaticResource CardTitleTextStyle}" />
                        <TextBlock Margin="0,8,0,0" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}">
                            <Run Text="الإصدار:" />
                            <Run Text="1.5.0 - المرحلة الخامسة" />
                            <Run Text="   |   قاعدة البيانات: SQL Server / Entity Framework Core 8" />
                        </TextBlock>
                        <TextBlock Margin="0,4,0,0" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                                   Text="أي تعديل على اسم المتجر أو عرض السطر يظهر فوراً على الإيصال التالي في نقطة البيع." />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="1" Margin="0,12,0,-12" Padding="14,8" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="{Binding StatusMessage}" FontSize="12" VerticalAlignment="Center"
                           Foreground="{StaticResource TextSecondaryBrush}" />

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="💾 حفظ الإعدادات" Width="160" Height="38" Style="{StaticResource BaseButtonStyle}"
                            Command="{Binding SaveCommand}" Margin="0,0,8,0" IsEnabled="{Binding CanEdit}" />
                    <Button Content="🔄 إعادة التحميل" Width="140" Height="38" Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding LoadCommand}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
