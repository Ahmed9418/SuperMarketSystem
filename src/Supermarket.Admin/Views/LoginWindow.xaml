<Window x:Class="Supermarket.Admin.Views.LoginWindow"
        Style="{StaticResource AppWindowStyle}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="تسجيل الدخول - نظام إدارة السوبر ماركت"
        Height="560" Width="880"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        Background="{StaticResource CanvasBrush}">

    <!--
        The window has no chrome, so it can be dragged: MouseLeftButtonDown on the brand panel calls
        DragMove (see the code-behind).
    -->
    <Grid>
        <Grid.ColumnDefinitions>
            <!-- Brand panel: the first column of an RTL grid is the right-hand side. -->
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="420" />
        </Grid.ColumnDefinitions>

        <!-- ============================ Brand panel ============================ -->
        <Border Grid.Column="0" Background="{StaticResource SidebarBrush}"
                MouseLeftButtonDown="OnBrandPanelMouseDown">
            <StackPanel VerticalAlignment="Center" Margin="40,0">
                <TextBlock Text="{Binding StoreName}" FontSize="30" FontWeight="Bold" Foreground="White" />
                <TextBlock Text="نظام إدارة متكامل للمبيعات والمخزون"
                           FontSize="15" Margin="0,10,0,0"
                           Foreground="{StaticResource SidebarTextBrush}"
                           TextWrapping="Wrap" />

                <Rectangle Height="1" Fill="{StaticResource SidebarDividerBrush}" Margin="0,28" />

                <TextBlock Text="✔ إدارة المنتجات والمخزون" Foreground="{StaticResource SidebarTextBrush}" Margin="0,6" />
                <TextBlock Text="✔ متابعة الموردين ونواقص المخزون" Foreground="{StaticResource SidebarTextBrush}" Margin="0,6" />
                <TextBlock Text="✔ تقارير المبيعات والأرباح" Foreground="{StaticResource SidebarTextBrush}" Margin="0,6" />
                <TextBlock Text="✔ إدارة المستخدمين والصلاحيات" Foreground="{StaticResource SidebarTextBrush}" Margin="0,6" />

                <TextBlock Text="الإصدار 1.0" Margin="0,34,0,0" FontSize="12"
                           Foreground="{StaticResource SidebarMutedBrush}" />
            </StackPanel>
        </Border>

        <!-- ============================= Login form ============================ -->
        <Grid Grid.Column="1" Margin="48,0" VerticalAlignment="Center">
            <StackPanel>
                <TextBlock Text="تسجيل الدخول" Style="{StaticResource PageTitleTextStyle}" FontSize="28" />
                <TextBlock Text="برجاء إدخال بيانات حسابك للمتابعة"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Margin="0,6,0,28" />

                <TextBlock Text="اسم المستخدم" Style="{StaticResource FieldLabelTextStyle}" />
                <TextBox x:Name="UserNameBox"
                         Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource LatinInputStyle}"
                         FontSize="15"
                         Margin="0,0,0,16" />

                <TextBlock Text="كلمة المرور" Style="{StaticResource FieldLabelTextStyle}" />
                <Grid Margin="0,0,0,16" FlowDirection="LeftToRight">
                    <!-- A PasswordBox cannot reveal its content, so a plain TextBox is swapped in when
                         the operator asks to see what was typed. -->
                    <PasswordBox x:Name="PasswordBox"
                                 Style="{StaticResource LatinPasswordStyle}"
                                 KeyDown="OnPasswordKeyDown"
                                 FontSize="15"
                                 Padding="8,6,8,6" />

                    <TextBox x:Name="PasswordVisibleBox"
                             Style="{StaticResource LatinInputStyle}"
                             KeyDown="OnPasswordKeyDown"
                             TextChanged="OnPasswordVisibleChanged"
                             FontSize="15"
                             Padding="8,6,8,6"
                             Visibility="Collapsed" />

                    <Button x:Name="TogglePasswordButton"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Width="32" Height="32"
                            Margin="0,0,4,0"
                            Padding="0"
                            FontSize="15"
                            Background="Transparent"
                            BorderThickness="0"
                            Cursor="Hand"
                            Focusable="False"
                            ToolTip="إظهار / إخفاء كلمة المرور"
                            Click="OnTogglePasswordClick"
                            Content="👁">
                        <Button.Style>
                            <Style TargetType="{x:Type Button}">
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="{x:Type Button}">
                                            <Border x:Name="border" Background="{TemplateBinding Background}"
                                                    CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="border" Property="Background" Value="#15000000" />
                                                    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter TargetName="border" Property="Background" Value="#25000000" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>

                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="{StaticResource DangerBrush}"
                           TextWrapping="Wrap"
                           Margin="0,4,0,8"
                           Visibility="{Binding ErrorMessage, Converter={StaticResource EmptyStringToVisibility}}" />

                <Button Content="دخول إلى النظام"
                        Height="44" FontSize="16"
                        IsDefault="True"
                        Click="OnSignInClick"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />

                <Button Content="إغلاق"
                        Style="{StaticResource GhostButtonStyle}"
                        Height="40" Margin="0,12,0,0"
                        Click="OnCloseClick" />

            </StackPanel>
        </Grid>
    </Grid>
</Window>
