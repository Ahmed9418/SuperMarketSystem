<Window x:Class="Supermarket.Admin.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="تسجيل الدخول - نظام إدارة السوبر ماركت"
        Height="560" Width="880"
        FlowDirection="RightToLeft"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="False"
        Background="{StaticResource CanvasBrush}">

    <Grid>
        <Grid.ColumnDefinitions>
            <!-- Brand panel: appears on the left in an RTL layout -->
            <ColumnDefinition Width="380" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ============================ Brand panel ============================ -->
        <Border Grid.Column="0" Background="{StaticResource SidebarBrush}">
            <StackPanel VerticalAlignment="Center" Margin="36,0">
                <TextBlock Text="سوبر ماركت الأمانة"
                           FontSize="30" FontWeight="Bold"
                           Foreground="White"
                           TextAlignment="Left" />
                <TextBlock Text="نظام إدارة متكامل للمبيعات والمخزون"
                           FontSize="15" Margin="0,10,0,0"
                           Foreground="{StaticResource SidebarTextBrush}"
                           TextWrapping="Wrap"
                           TextAlignment="Left" />

                <Rectangle Height="1" Fill="{StaticResource SidebarDividerBrush}" Margin="0,28" />

                <TextBlock Text="✔ إدارة المنتجات والمخزون" Foreground="{StaticResource SidebarTextBrush}" Margin="0,6" />
                <TextBlock Text="✔ متابعة الموردين ونواقص المخزون" Foreground="{StaticResource SidebarTextBrush}" Margin="0,6" />
                <TextBlock Text="✔ تقارير المبيعات والأرباح" Foreground="{StaticResource SidebarTextBrush}" Margin="0,6" />
                <TextBlock Text="✔ إدارة المستخدمين والصلاحيات" Foreground="{StaticResource SidebarTextBrush}" Margin="0,6" />

                <TextBlock Text="الإصدار - 1.0 - المرحلة الأولى"
                           Margin="0,34,0,0"
                           FontSize="12"
                           Foreground="{StaticResource SidebarMutedBrush}" />
            </StackPanel>
        </Border>

        <!-- ============================= Login form ============================ -->
        <Grid Grid.Column="1" Margin="48,0,48,0" VerticalAlignment="Center">
            <StackPanel>
                <TextBlock Text="تسجيل الدخول" Style="{StaticResource PageTitleTextStyle}" FontSize="28" />
                <TextBlock Text="برجاء إدخال بيانات حسابك للمتابعة"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Margin="0,6,0,28" />

                <TextBlock Text="اسم المستخدم" Style="{StaticResource FieldLabelTextStyle}" />
                <TextBox x:Name="UserNameBox"
                         Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged}"
                         FlowDirection="LeftToRight"
                         TextAlignment="Left"
                         FontSize="15"
                         Margin="0,0,0,16" />

                <TextBlock Text="كلمة المرور" Style="{StaticResource FieldLabelTextStyle}" />
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- The PasswordBox keeps the secret masked; the TextBox is only shown when the
                         operator asks to reveal it (a PasswordBox cannot unmask itself). -->
                    <PasswordBox x:Name="PasswordBox"
                                 Grid.Column="0"
                                 KeyDown="OnPasswordKeyDown"
                                 FlowDirection="LeftToRight"
                                 FontSize="15" />

                    <TextBox x:Name="PasswordVisibleBox"
                             Grid.Column="0"
                             KeyDown="OnPasswordKeyDown"
                             TextChanged="OnPasswordVisibleChanged"
                             FlowDirection="LeftToRight"
                             FontSize="15"
                             Visibility="Collapsed" />

                    <Button x:Name="TogglePasswordButton"
                            Grid.Column="1"
                            Width="46"
                            Height="38"
                            Margin="6,0,0,0"
                            Padding="0"
                            FontSize="16"
                            Style="{StaticResource GhostButtonStyle}"
                            ToolTip="إظهار / إخفاء كلمة المرور"
                            Click="OnTogglePasswordClick"
                            Content="👁" />
                </Grid>

                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="{StaticResource DangerBrush}"
                           TextWrapping="Wrap"
                           Margin="0,4,0,8"
                           Visibility="{Binding ErrorMessage, Converter={StaticResource EmptyStringToVisibility}}" />

                <Button Content="دخول إلى النظام"
                        Height="44"
                        FontSize="16"
                        IsDefault="True"
                        Click="OnSignInClick"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolean}}" />

                <Button Content="إغلاق"
                        Style="{StaticResource GhostButtonStyle}"
                        Height="40"
                        Margin="0,12,0,0"
                        Click="OnCloseClick" />

                <TextBlock Text="حساب افتراضي: admin / Admin@123"
                           Margin="0,24,0,0"
                           FontSize="12"
                           Foreground="{StaticResource TextSecondaryBrush}" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
