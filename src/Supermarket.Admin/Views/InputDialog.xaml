<Window x:Class="Supermarket.Admin.Views.InputDialog"
        Style="{StaticResource AppWindowStyle}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Height="230" Width="500"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{StaticResource CanvasBrush}">

    <Border Style="{StaticResource CardBorderStyle}" Margin="16" Padding="18">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock x:Name="MessageText" Grid.Row="0" TextWrapping="Wrap"
                       Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,12" />

            <TextBox x:Name="InputBox" Grid.Row="1" />

            <!-- In an RTL layout the first button of a horizontal stack sits on the right. -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,18,0,0">
                <Button Content="موافق" Width="110" IsDefault="True" Click="OnOkClick" />
                <Button Content="إلغاء" Width="100" Margin="8,0,0,0"
                        Style="{StaticResource GhostButtonStyle}"
                        IsCancel="True" Click="OnCancelClick" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
