<Window x:Class="Supermarket.Admin.Views.InputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Height="220" Width="480"
        FlowDirection="RightToLeft"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{StaticResource CanvasBrush}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="MessageText" Grid.Row="0" TextWrapping="Wrap"
                   Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,12" />

        <TextBox x:Name="InputBox" Grid.Row="1" VerticalAlignment="Top" />

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Left">
            <Button Content="موافق" Width="110" IsDefault="True" Click="OnOkClick" />
            <Button Content="إلغاء" Width="100" Margin="8,0,0,0"
                    Style="{StaticResource GhostButtonStyle}"
                    IsCancel="True" Click="OnCancelClick" />
        </StackPanel>
    </Grid>
</Window>
