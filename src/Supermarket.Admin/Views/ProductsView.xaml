<UserControl x:Class="Supermarket.Admin.Views.ProductsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ============================== Toolbar ============================== -->
        <Border Grid.Row="0" Style="{StaticResource CardBorderStyle}" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Filters -->
                <WrapPanel Grid.Column="0" Orientation="Horizontal">
                    <StackPanel Width="280" Margin="0,0,12,0">
                        <TextBlock Text="بحث بالاسم أو البار كود" Style="{StaticResource FieldLabelTextStyle}" />
                        <TextBox Text="{Binding SearchTerm, UpdateSourceTrigger=PropertyChanged, Delay=100}"
                                 ToolTip="اكتب اسم المنتج أو البار كود" />
                    </StackPanel>

                    <StackPanel Width="180" Margin="0,0,12,0">
                        <TextBlock Text="القسم" Style="{StaticResource FieldLabelTextStyle}" />
                        <ComboBox ItemsSource="{Binding Categories}"
                                  DisplayMemberPath="Name"
                                  SelectedItem="{Binding SelectedCategory}" />
                    </StackPanel>

                    <CheckBox Content="نواقص المخزون فقط"
                              IsChecked="{Binding LowStockOnly}"
                              Height="34" VerticalAlignment="Bottom" Margin="0,0,12,10" />

                    <Button Content="مسح الفلاتر" Style="{StaticResource GhostButtonStyle}"
                            VerticalAlignment="Bottom" Margin="0,0,0,1"
                            Command="{Binding ClearFiltersCommand}" />
                </WrapPanel>

                <!-- Actions -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                    <Button Content="➕ منتج جديد" Width="140"
                            Command="{Binding OpenEditorCommand}"
                            CommandParameter="{x:Null}" />
                    <Button Content="✏ تعديل المحدد" Width="150" Margin="8,0,0,0"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding OpenEditorCommand}"
                            CommandParameter="{Binding SelectedProduct}" />
                    <Button Content="🗑 حذف المنتج" Width="140" Margin="8,0,0,0"
                            Style="{StaticResource DangerButtonStyle}"
                            Command="{Binding DeleteProductCommand}"
                            CommandParameter="{Binding SelectedProduct}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============================== Grid =============================== -->
        <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Padding="0">
            <DataGrid ItemsSource="{Binding Products}"
                      SelectedItem="{Binding SelectedProduct}">
                <DataGrid.RowStyle>
                    <!-- BasedOn keeps the hover / selection colours of the theme. -->
                    <Style TargetType="{x:Type DataGridRow}" BasedOn="{StaticResource DataGridRowStyle}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsLowStock}" Value="True">
                                <Setter Property="Background" Value="{StaticResource WarningLightBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsOutOfStock}" Value="True">
                                <Setter Property="Background" Value="{StaticResource DangerLightBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsActive}" Value="False">
                                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                                <Setter Property="FontStyle" Value="Italic" />
                            </DataTrigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>

                <DataGrid.Columns>
                    <DataGridTextColumn Header="اسم المنتج" Binding="{Binding Name}" SortMemberPath="Name" Width="*" MinWidth="200" />
                    <!-- Latin / numeric columns keep their own reading order. -->
                    <DataGridTextColumn Header="البار كود" SortMemberPath="Barcode" Width="140">
                        <DataGridTextColumn.Binding>
                            <Binding Path="Barcode" Converter="{StaticResource RtlIsolation}" />
                        </DataGridTextColumn.Binding>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="القسم" Binding="{Binding CategoryName}" SortMemberPath="CategoryName" Width="120" />
                    <DataGridTextColumn Header="الوحدة" Binding="{Binding UnitName}" SortMemberPath="UnitName" Width="80" />
                    <DataGridTextColumn Header="سعر الشراء" Width="120"
                                        SortMemberPath="CostPrice"
                                        Binding="{Binding CostPrice, Converter={StaticResource EgpCurrency}}" />
                    <DataGridTextColumn Header="سعر البيع" Width="120"
                                        SortMemberPath="SellingPrice"
                                        Binding="{Binding SellingPrice, Converter={StaticResource EgpCurrency}}" />
                    <DataGridTextColumn Header="الكمية" Width="90"
                                        SortMemberPath="StockQuantity"
                                        Binding="{Binding StockQuantity, StringFormat={}{0:N2}}" />
                    <DataGridTextColumn Header="حد الطلب" Width="90"
                                        SortMemberPath="MinimumStockLevel"
                                        Binding="{Binding MinimumStockLevel, StringFormat={}{0:N2}}" />
                    <DataGridTemplateColumn Header="الحالة" SortMemberPath="IsActive" Width="110">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock FontWeight="SemiBold">
                                    <TextBlock.Style>
                                        <Style TargetType="{x:Type TextBlock}">
                                            <Setter Property="Text" Value="متوفر" />
                                            <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                    <Setter Property="Text" Value="موقوف" />
                                                    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsLowStock}" Value="True">
                                                    <Setter Property="Text" Value="قارب على النفاد" />
                                                    <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsOutOfStock}" Value="True">
                                                    <Setter Property="Text" Value="غير متوفر" />
                                                    <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- ============================= Footer ============================== -->
        <Grid Grid.Row="2" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="{Binding StatusMessage}"
                       Foreground="{StaticResource TextSecondaryBrush}" />

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <!-- "السابق" is the previous page; in RTL it visually sits to the right of "التالي". -->
                <Button Content="السابق" Style="{StaticResource SecondaryButtonStyle}" Width="90"
                        IsEnabled="{Binding HasPreviousPage}"
                        Command="{Binding PreviousPageCommand}" />
                <TextBlock Text="{Binding PageNumber, StringFormat='صفحة {0}'}"
                           Margin="12,0" VerticalAlignment="Center" />
                <Button Content="التالي" Style="{StaticResource SecondaryButtonStyle}" Width="90"
                        IsEnabled="{Binding HasNextPage}"
                        Command="{Binding NextPageCommand}" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>