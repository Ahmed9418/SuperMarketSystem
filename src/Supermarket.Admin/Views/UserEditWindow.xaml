<Window x:Class="Supermarket.Admin.Views.UserEditWindow"
        Style="{StaticResource AppWindowStyle}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}"
        Height="620" Width="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource CanvasBrush}">

    <Window.Resources>
        <Style x:Key="FormLabelStyle" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource FieldLabelTextStyle}">
            <Setter Property="Margin" Value="0,10,0,4" />
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitleTextStyle}" FontSize="20" />
            <TextBlock Text="كلمة المرور والرقم السري يُخزَّنان مشفّرين ولا يمكن استرجاعهما."
                       FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                       TextWrapping="Wrap" Margin="0,6,0,0" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="الاسم الكامل" Style="{StaticResource FormLabelStyle}" Margin="0,0,0,4" />
                <TextBox Text="{Binding FullName, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Text="اسم المستخدم (بالإنجليزية)" Style="{StaticResource FormLabelStyle}" />
                <TextBox Style="{StaticResource LatinInputStyle}"
                         Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Text="الدور" Style="{StaticResource FormLabelStyle}" />
                <ComboBox ItemsSource="{Binding Roles}" DisplayMemberPath="Name"
                          SelectedItem="{Binding SelectedRole}" Height="38" />

                <TextBlock Text="رقم الهاتف" Style="{StaticResource FormLabelStyle}" />
                <TextBox Style="{StaticResource LatinInputStyle}"
                         Text="{Binding PhoneNumber, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Text="كلمة المرور" Style="{StaticResource FormLabelStyle}" />
                <TextBox Style="{StaticResource LatinInputStyle}"
                         Text="{Binding Password, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Text="{Binding PasswordHint}" FontSize="11"
                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,3,0,0" />

                <TextBlock Text="الرقم السري للكاشير" Style="{StaticResource FormLabelStyle}" />
                <TextBox Style="{StaticResource LatinInputStyle}" MaxLength="4"
                         Text="{Binding Pin, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Text="{Binding PinHint}" FontSize="11"
                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,3,0,0" />

                <CheckBox Content="الحساب نشط" IsChecked="{Binding IsActive}" Margin="0,14,0,0" />

                <Border Background="{StaticResource DangerLightBrush}"
                        BorderBrush="{StaticResource DangerBrush}" BorderThickness="1"
                        CornerRadius="6" Padding="10" Margin="0,12,0,0"
                        Visibility="{Binding ErrorMessage, Converter={StaticResource EmptyStringToVisibility}}">
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}"
                               TextWrapping="Wrap" FontSize="12" />
                </Border>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,14,0,0">
            <Button Content="💾 حفظ" Width="130" Height="40" Margin="0,0,8,0"
                    Command="{Binding SaveCommand}" />
            <Button Content="إلغاء" Width="110" Height="40"
                    Style="{StaticResource SecondaryButtonStyle}"
                    IsCancel="True" Click="OnCancelClick" />
        </StackPanel>
    </Grid>
</Window>
