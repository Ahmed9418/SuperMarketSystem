<Window x:Class="Supermarket.Admin.Views.UserEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}"
        Height="620" Width="520"
        WindowStartupLocation="CenterOwner"
        FlowDirection="RightToLeft"
        ResizeMode="NoResize"
        Background="{StaticResource CanvasBrush}"
        FontFamily="{StaticResource AppFontFamily}">

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitleTextStyle}" FontSize="20" />
            <TextBlock Text="كلمة المرور والرقم السري يُخزَّنان مشفّرين (PBKDF2) ولا يمكن استرجاعهما."
                       FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,6,0,0" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="الاسم الكامل" Style="{StaticResource FieldLabelTextStyle}" />
                <TextBox Text="{Binding FullName, UpdateSourceTrigger=PropertyChanged}" Height="38" />

                <TextBlock Text="اسم المستخدم (بالإنجليزية)" Style="{StaticResource FieldLabelTextStyle}" Margin="0,10,0,0" />
                <TextBox Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged}" Height="38"
                         FlowDirection="LeftToRight" />

                <TextBlock Text="الدور" Style="{StaticResource FieldLabelTextStyle}" Margin="0,10,0,0" />
                <ComboBox ItemsSource="{Binding Roles}" DisplayMemberPath="Name"
                          SelectedItem="{Binding SelectedRole}" Height="38" />

                <TextBlock Text="رقم الهاتف" Style="{StaticResource FieldLabelTextStyle}" Margin="0,10,0,0" />
                <TextBox Text="{Binding PhoneNumber, UpdateSourceTrigger=PropertyChanged}" Height="38"
                         FlowDirection="LeftToRight" />

                <TextBlock Text="كلمة المرور" Style="{StaticResource FieldLabelTextStyle}" Margin="0,10,0,0" />
                <TextBox Text="{Binding Password, UpdateSourceTrigger=PropertyChanged}" Height="38"
                         FlowDirection="LeftToRight" />
                <TextBlock Text="{Binding PasswordHint}" FontSize="11"
                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,3,0,0" />

                <TextBlock Text="الرقم السري للكاشير" Style="{StaticResource FieldLabelTextStyle}" Margin="0,10,0,0" />
                <TextBox Text="{Binding Pin, UpdateSourceTrigger=PropertyChanged}" Height="38" MaxLength="4"
                         FlowDirection="LeftToRight" />
                <TextBlock Text="{Binding PinHint}" FontSize="11"
                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,3,0,0" />

                <CheckBox Content="الحساب نشط" IsChecked="{Binding IsActive}" Margin="0,14,0,0" />

                <Border Background="{StaticResource DangerLightBrush}" BorderBrush="{StaticResource DangerBrush}" BorderThickness="1"
                        CornerRadius="6" Padding="10" Margin="0,12,0,0"
                        Visibility="{Binding ErrorMessage, Converter={StaticResource EmptyStringToVisibility}}">
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}"
                               TextWrapping="Wrap" FontSize="12" />
                </Border>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,14,0,0">
            <Button Content="💾 حفظ" Width="130" Height="40" Style="{StaticResource BaseButtonStyle}"
                    Command="{Binding SaveCommand}" Margin="0,0,8,0" />
            <Button Content="إلغاء" Width="110" Height="40" Style="{StaticResource SecondaryButtonStyle}"
                    IsCancel="True" Click="OnCancelClick" />
        </StackPanel>
    </Grid>
</Window>
