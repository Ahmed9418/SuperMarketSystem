<UserControl x:Class="Supermarket.Admin.Views.LowStockView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <!-- Summary card -->
        <Border Grid.Row="0" Style="{StaticResource CardBorderStyle}" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="نواقص المخزون" Style="{StaticResource PageTitleTextStyle}" />
                    <TextBlock Text="{Binding SummaryText}" Foreground="{StaticResource TextSecondaryBrush}"
                               TextWrapping="Wrap" Margin="0,6,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="24,0" VerticalAlignment="Center">
                    <TextBlock Text="التكلفة التقديرية للتوريد" Style="{StaticResource FieldLabelTextStyle}" />
                    <TextBlock Text="{Binding EstimatedReorderCost, Converter={StaticResource EgpCurrency}}"
                               FontSize="20" FontWeight="Bold" Foreground="{StaticResource DangerBrush}" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="📥 توريد الصنف المحدد"
                            Height="38" Padding="14,0" Margin="0,0,8,0"
                            Command="{Binding ReceiveStockCommand}" />
                    <Button Content="🔄 تحديث القائمة"
                            Height="38" Padding="14,0"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding LoadCommand}" />
                </StackPanel>
            </Grid>
        </Border>
        <!-- Grid -->
        <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Padding="0">
            <DataGrid ItemsSource="{Binding Products}"
                      SelectedItem="{Binding SelectedProduct}">
                <DataGrid.InputBindings>
                    <MouseBinding Gesture="LeftDoubleClick"
                                  Command="{Binding ReceiveStockCommand}"
                                  CommandParameter="{Binding SelectedProduct}" />
                </DataGrid.InputBindings>
                <DataGrid.RowStyle>
                    <Style TargetType="{x:Type DataGridRow}" BasedOn="{StaticResource DataGridRowStyle}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsOutOfStock}" Value="True">
                                <Setter Property="Background" Value="{StaticResource DangerLightBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="اسم المنتج" Binding="{Binding Name}" Width="*" MinWidth="200" />
                    <DataGridTextColumn Header="البار كود" Width="140"
                                        Binding="{Binding Barcode, Converter={StaticResource RtlIsolation}}" />
                    <DataGridTextColumn Header="القسم" Binding="{Binding CategoryName}" Width="120" />
                    <DataGridTextColumn Header="المورد" Binding="{Binding SupplierName}" Width="150" />
                    <DataGridTextColumn Header="الكمية الحالية" Width="110"
                                        Binding="{Binding StockQuantity, StringFormat={}{0:N2}}" />
                    <DataGridTextColumn Header="حد الطلب" Width="100"
                                        Binding="{Binding MinimumStockLevel, StringFormat={}{0:N2}}" />
                    <DataGridTextColumn Header="الكمية المطلوبة" Width="120"
                                        Binding="{Binding ReorderQuantity, StringFormat={}{0:N2}}" />
                    <DataGridTextColumn Header="تكلفة التوريد" Width="140"
                                        Binding="{Binding StockValue, Converter={StaticResource EgpCurrency}}" />
                    <DataGridTemplateColumn Header="إجراء" Width="100">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="📥 توريد"
                                        Height="28" Padding="10,0" FontSize="12"
                                        Command="{Binding DataContext.ReceiveStockCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
