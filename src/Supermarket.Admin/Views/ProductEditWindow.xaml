<Window x:Class="Supermarket.Admin.Views.ProductEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}"
        Height="780" Width="900"
        FlowDirection="RightToLeft"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        MinHeight="640" MinWidth="820"
        ShowInTaskbar="False"
        Background="{StaticResource CanvasBrush}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitleTextStyle}" />
            <TextBlock Text="الحقول المعلمة بـ (*) مطلوبة" FontSize="12"
                       Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0" />
        </StackPanel>

        <!-- Form -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- ======================= Basic data ======================= -->
                <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="البيانات الأساسية" Style="{StaticResource CardTitleTextStyle}" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,12">
                                <TextBlock Text="اسم المنتج *" Style="{StaticResource FieldLabelTextStyle}" />
                                <TextBox Text="{Binding ProductName, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>

                            <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,12">
                                <TextBlock Text="الوصف / الحجم" Style="{StaticResource FieldLabelTextStyle}" />
                                <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="0">
                                <TextBlock Text="البار كود *" Style="{StaticResource FieldLabelTextStyle}" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0"
                                             Text="{Binding Barcode, UpdateSourceTrigger=PropertyChanged}" />
                                    <Button Grid.Column="1" Content="توليد تلقائي" Width="110" Margin="8,0,0,0"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Command="{Binding GenerateBarcodeCommand}" />
                                </Grid>
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="2">
                                <TextBlock Text="بار كود بديل (اختياري)" Style="{StaticResource FieldLabelTextStyle}" />
                                <TextBox Text="{Binding AlternativeBarcode, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ===================== Classification ===================== -->
                <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="التصنيف والوحدات" Style="{StaticResource CardTitleTextStyle}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="القسم *" Style="{StaticResource FieldLabelTextStyle}" />
                                <ComboBox ItemsSource="{Binding Categories}"
                                          DisplayMemberPath="Name"
                                          SelectedItem="{Binding SelectedCategory}" />
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="وحدة القياس *" Style="{StaticResource FieldLabelTextStyle}" />
                                <ComboBox ItemsSource="{Binding Units}"
                                          DisplayMemberPath="Name"
                                          SelectedItem="{Binding SelectedUnit}" />
                            </StackPanel>

                            <StackPanel Grid.Column="4">
                                <TextBlock Text="المورد" Style="{StaticResource FieldLabelTextStyle}" />
                                <ComboBox ItemsSource="{Binding Suppliers}"
                                          DisplayMemberPath="Name"
                                          SelectedItem="{Binding SelectedSupplier}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ========================= Pricing ======================== -->
                <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="الأسعار والضريبة" Style="{StaticResource CardTitleTextStyle}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="سعر الشراء (ج.م) *" Style="{StaticResource FieldLabelTextStyle}" />
                                <TextBox Text="{Binding CostPrice, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:N2}}" />
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="سعر البيع (ج.م) *" Style="{StaticResource FieldLabelTextStyle}" />
                                <TextBox Text="{Binding SellingPrice, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:N2}}" />
                            </StackPanel>

                            <StackPanel Grid.Column="4">
                                <TextBlock Text="سعر الخصم (ج.م)" Style="{StaticResource FieldLabelTextStyle}" />
                                <TextBox Text="{Binding DiscountPrice, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}" />
                            </StackPanel>

                            <StackPanel Grid.Column="6">
                                <TextBlock Text="نسبة الضريبة %" Style="{StaticResource FieldLabelTextStyle}" />
                                <TextBox Text="{Binding VatRate, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:N2}}" />
                            </StackPanel>

                            <StackPanel Grid.Column="8">
                                <TextBlock Text="هامش الربح" Style="{StaticResource FieldLabelTextStyle}" />
                                <Border Background="{StaticResource PrimaryLightBrush}" CornerRadius="6" Height="34">
                                    <TextBlock Text="{Binding MarginText}" HorizontalAlignment="Center"
                                               FontWeight="Bold" Foreground="{StaticResource PrimaryDarkBrush}" />
                                </Border>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ======================== Stock ========================== -->
                <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="المخزون" Style="{StaticResource CardTitleTextStyle}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="حد الطلب الأدنى" Style="{StaticResource FieldLabelTextStyle}" />
                                <TextBox Text="{Binding MinimumStockLevel, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:N2}}" />
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="كمية إعادة الطلب" Style="{StaticResource FieldLabelTextStyle}" />
                                <TextBox Text="{Binding ReorderQuantity, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:N2}}" />
                            </StackPanel>

                            <StackPanel Grid.Column="4">
                                <TextBlock Text="الرصيد الافتتاحي (للمنتج الجديد)"
                                           Style="{StaticResource FieldLabelTextStyle}" />
                                <TextBox Text="{Binding InitialStock, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:N2}}"
                                         IsEnabled="{Binding IsEditMode, Converter={StaticResource InverseBoolean}}" />
                            </StackPanel>

                            <StackPanel Grid.Column="6">
                                <TextBlock Text="مكان التخزين" Style="{StaticResource FieldLabelTextStyle}" />
                                <TextBox Text="{Binding ShelfLocation, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </Grid>

                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                            <CheckBox Content="يُباع بالوزن (كيلو / جرام)"
                                      IsChecked="{Binding IsWeighted}"
                                      FlowDirection="RightToLeft"
                                      VerticalContentAlignment="Center" Margin="0,0,24,0" />
                            <CheckBox Content="المنتج مُفعّل للبيع"
                                      IsChecked="{Binding IsActive}"
                                      FlowDirection="RightToLeft"
                                      VerticalContentAlignment="Center" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <Grid Grid.Row="2" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="{Binding ErrorMessage}"
                       Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap"
                       VerticalAlignment="Center"
                       Visibility="{Binding ErrorMessage, Converter={StaticResource EmptyStringToVisibility}}" />

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="💾 حفظ المنتج" Width="150" Command="{Binding SaveCommand}" IsDefault="True" />
                <Button Content="إلغاء" Width="110" Margin="8,0,0,0"
                        Style="{StaticResource GhostButtonStyle}"
                        IsCancel="True" Click="OnCancelClick" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
