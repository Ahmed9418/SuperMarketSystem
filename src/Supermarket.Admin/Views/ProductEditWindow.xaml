<Window x:Class="Supermarket.Admin.Views.ProductEditWindow"
        Style="{StaticResource AppWindowStyle}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}"
        Height="780" Width="900"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        MinHeight="640" MinWidth="820"
        ShowInTaskbar="False"
        Background="{StaticResource CanvasBrush}">

    <Window.Resources>
        <Style x:Key="FormLabelStyle" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource FieldLabelTextStyle}">
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
        <Style x:Key="FormFieldStyle" TargetType="{x:Type StackPanel}">
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitleTextStyle}" />
            <TextBlock Text="الحقول المعلمة بـ (*) مطلوبة" FontSize="12"
                       Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0" />
        </StackPanel>

        <!-- Form -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- ======================= Basic data ======================= -->
                <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="البيانات الأساسية" Style="{StaticResource CardTitleTextStyle}" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Style="{StaticResource FormFieldStyle}">
                                <TextBlock Text="اسم المنتج *" Style="{StaticResource FormLabelStyle}" />
                                <TextBox Text="{Binding ProductName, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>

                            <StackPanel Grid.Column="2" Style="{StaticResource FormFieldStyle}">
                                <TextBlock Text="الوصف / الحجم" Style="{StaticResource FormLabelStyle}" />
                                <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Style="{StaticResource FormFieldStyle}">
                                <TextBlock Text="البار كود *" Style="{StaticResource FormLabelStyle}" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Style="{StaticResource LatinInputStyle}"
                                             Text="{Binding Barcode, UpdateSourceTrigger=PropertyChanged}" />
                                    <Button Grid.Column="1" Content="توليد تلقائي" Width="110" Margin="8,0,0,0"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Command="{Binding GenerateBarcodeCommand}" />
                                </Grid>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Style="{StaticResource FormFieldStyle}">
                                <TextBlock Text="بار كود بديل (اختياري)" Style="{StaticResource FormLabelStyle}" />
                                <TextBox Style="{StaticResource LatinInputStyle}"
                                         Text="{Binding AlternativeBarcode, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ===================== Classification ===================== -->
                <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="التصنيف والوحدات" Style="{StaticResource CardTitleTextStyle}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="القسم *" Style="{StaticResource FormLabelStyle}" />
                                <ComboBox ItemsSource="{Binding Categories}" DisplayMemberPath="Name"
                                          SelectedItem="{Binding SelectedCategory}" />
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="وحدة القياس *" Style="{StaticResource FormLabelStyle}" />
                                <ComboBox ItemsSource="{Binding Units}" DisplayMemberPath="Name"
                                          SelectedItem="{Binding SelectedUnit}" />
                            </StackPanel>

                            <StackPanel Grid.Column="4">
                                <TextBlock Text="المورد" Style="{StaticResource FormLabelStyle}" />
                                <ComboBox ItemsSource="{Binding Suppliers}" DisplayMemberPath="Name"
                                          SelectedItem="{Binding SelectedSupplier}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ========================= Pricing ======================== -->
                <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="الأسعار والضريبة" Style="{StaticResource CardTitleTextStyle}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="سعر الشراء (ج.م) *" Style="{StaticResource FormLabelStyle}" />
                                <TextBox Style="{StaticResource NumericInputStyle}"
                                         Text="{Binding CostPrice, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:N2}}" />
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="سعر البيع (ج.م) *" Style="{StaticResource FormLabelStyle}" />
                                <TextBox Style="{StaticResource NumericInputStyle}"
                                         Text="{Binding SellingPrice, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:N2}}" />
                            </StackPanel>

                            <StackPanel Grid.Column="4">
                                <TextBlock Text="نسبة الضريبة %" Style="{StaticResource FormLabelStyle}" />
                                <TextBox Style="{StaticResource NumericInputStyle}"
                                         Text="{Binding VatRate, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:N2}}" />
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="سعر الخصم (ج.م)" Style="{StaticResource FormLabelStyle}" />
                                <TextBox Style="{StaticResource NumericInputStyle}"
                                         Text="{Binding DiscountPrice, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}" />
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="حد الطلب الأدنى" Style="{StaticResource FormLabelStyle}" />
                                <TextBox Style="{StaticResource NumericInputStyle}"
                                         Text="{Binding MinimumStockLevel, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:N2}}" />
                            </StackPanel>

                            <StackPanel Grid.Column="4">
                                <TextBlock Text="كمية إعادة الطلب" Style="{StaticResource FormLabelStyle}" />
                                <TextBox Style="{StaticResource NumericInputStyle}"
                                         Text="{Binding ReorderQuantity, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:N2}}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ==================== Stock & location ==================== -->
                <Border Style="{StaticResource CardBorderStyle}">
                    <StackPanel>
                        <TextBlock Text="المخزون والموقع" Style="{StaticResource CardTitleTextStyle}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="الرصيد الافتتاحي (للمنتج الجديد)"
                                           Style="{StaticResource FormLabelStyle}" />
                                <TextBox Style="{StaticResource NumericInputStyle}"
                                         Text="{Binding InitialStock, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:N2}}"
                                         IsEnabled="{Binding IsEditMode, Converter={StaticResource InverseBool}}" />
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="مكان التخزين" Style="{StaticResource FormLabelStyle}" />
                                <TextBox Text="{Binding ShelfLocation, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </Grid>

                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                            <CheckBox Content="يُباع بالوزن (كيلو / جرام)"
                                      IsChecked="{Binding IsWeighted}" Margin="0,0,24,0" />
                            <CheckBox Content="المنتج مُفعّل للبيع" IsChecked="{Binding IsActive}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <Grid Grid.Row="2" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="{Binding ErrorMessage}"
                       Style="{StaticResource ErrorTextStyle}" Margin="0" VerticalAlignment="Center" />

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="💾 حفظ المنتج" Width="150" IsDefault="True"
                        Command="{Binding SaveCommand}" />
                <Button Content="إلغاء" Width="110" Margin="8,0,0,0"
                        Style="{StaticResource GhostButtonStyle}"
                        IsCancel="True" Click="OnCancelClick" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
