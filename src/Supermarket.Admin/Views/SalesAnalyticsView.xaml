<UserControl x:Class="Supermarket.Admin.Views.SalesAnalyticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF">

    <UserControl.Resources>
        <Style x:Key="FilterLabelStyle" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource FieldLabelTextStyle}">
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ============================= Filter bar ============================= -->
        <Border Grid.Row="0" Style="{StaticResource CardBorderStyle}" Padding="14,10" Margin="0,0,0,12">
            <WrapPanel>
                <StackPanel Width="140" Margin="0,0,12,0">
                    <TextBlock Text="الفترة" Style="{StaticResource FilterLabelStyle}" />
                    <ComboBox ItemsSource="{Binding PeriodPresets}"
                              SelectedItem="{Binding SelectedPeriod}"
                              SelectionChanged="OnPeriodChanged" />
                </StackPanel>

                <StackPanel Width="140" Margin="0,0,12,0">
                    <TextBlock Text="من تاريخ" Style="{StaticResource FilterLabelStyle}" />
                    <DatePicker SelectedDate="{Binding FromDate}" />
                </StackPanel>

                <StackPanel Width="140" Margin="0,0,12,0">
                    <TextBlock Text="إلى تاريخ" Style="{StaticResource FilterLabelStyle}" />
                    <DatePicker SelectedDate="{Binding ToDate}" />
                </StackPanel>

                <StackPanel Width="170" Margin="0,0,12,0">
                    <TextBlock Text="الكاشير" Style="{StaticResource FilterLabelStyle}" />
                    <ComboBox ItemsSource="{Binding Cashiers}" DisplayMemberPath="Name"
                              SelectedItem="{Binding SelectedCashier}" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                    <Button Content="🔍 عرض" Width="100" Margin="0,0,8,0"
                            Command="{Binding ApplyFilterCommand}" />
                    <Button Content="🔄 تحديث" Width="110" Margin="0,0,8,0"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding LoadCommand}" />
                    <Button Content="⬇ تصدير الفواتير (CSV)" Width="190"
                            Style="{StaticResource GhostButtonStyle}"
                            Command="{Binding ExportCommand}" />
                </StackPanel>
            </WrapPanel>
        </Border>

        <!-- ================================ Body ================================ -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- KPI tiles -->
                <UniformGrid Columns="4" Margin="0,0,0,12">
                    <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,12,0">
                        <StackPanel>
                            <TextBlock Text="إجمالي المبيعات" Style="{StaticResource FieldLabelTextStyle}" />
                            <TextBlock Text="{Binding Analytics.NetSales, Converter={StaticResource EgpCurrency}}"
                                       FontSize="24" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" />
                            <TextBlock FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,6,0,0">
                                <Run Text="{Binding Analytics.InvoiceCount, Mode=OneWay}" />
                                <Run Text="فاتورة - متوسط " />
                                <Run Text="{Binding Analytics.AverageInvoice, Mode=OneWay, StringFormat='{}{0:N2}'}" />
                                <Run Text="ج.م" />
                            </TextBlock>
                            <TextBlock Text="{Binding GrowthText}" FontSize="12" Margin="0,4,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="{x:Type TextBlock}">
                                        <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsGrowthPositive}" Value="False">
                                                <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,12,0">
                        <StackPanel>
                            <TextBlock Text="صافي الربح" Style="{StaticResource FieldLabelTextStyle}" />
                            <TextBlock Text="{Binding Analytics.TotalProfit, Converter={StaticResource EgpCurrency}}"
                                       FontSize="24" FontWeight="Bold" Foreground="{StaticResource PrimaryDarkBrush}" />
                            <TextBlock FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,6,0,0">
                                <Run Text="هامش الربح: " />
                                <Run Text="{Binding Analytics.ProfitMargin, Mode=OneWay, StringFormat='{}{0:N1}%'}" />
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,12,0">
                        <StackPanel>
                            <TextBlock Text="عدد الأصناف المباعة" Style="{StaticResource FieldLabelTextStyle}" />
                            <TextBlock Text="{Binding Analytics.TotalQuantity, StringFormat='{}{0:N2}'}"
                                       FontSize="24" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                            <TextBlock FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,6,0,0">
                                <Run Text="{Binding Analytics.ItemsSold, Mode=OneWay}" />
                                <Run Text="سطر - خصم " />
                                <Run Text="{Binding Analytics.TotalDiscount, Mode=OneWay, StringFormat='{}{0:N2}'}" />
                                <Run Text="ج.م" />
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardBorderStyle}">
                        <StackPanel>
                            <TextBlock Text="الورديّات المقفلة والنقدية" Style="{StaticResource FieldLabelTextStyle}" />
                            <TextBlock Text="{Binding Analytics.ClosedShifts}" FontSize="24" FontWeight="Bold"
                                       Foreground="{StaticResource AccentBrush}" />
                            <TextBlock Text="{Binding CashDifferenceText}" FontSize="12" Margin="0,6,0,0"
                                       Foreground="{StaticResource TextSecondaryBrush}" />
                            <TextBlock FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0">
                                <Run Text="مبيعات آجلة: " />
                                <Run Text="{Binding Analytics.CreditSales, Mode=OneWay, StringFormat='{}{0:N2}'}" />
                                <Run Text="ج.م" />
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <!-- Sales trend + payment split -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" Margin="0,0,12,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="حركة المبيعات والأرباح اليومية"
                                       Style="{StaticResource CardTitleTextStyle}" />
                            <lvc:CartesianChart Grid.Row="1" Height="280" Margin="0,8,0,0"
                                                FlowDirection="LeftToRight"
                                                Series="{Binding SalesSeries}"
                                                XAxes="{Binding SalesXAxes}"
                                                YAxes="{Binding SalesYAxes}"
                                                TooltipPosition="Top"
                                                LegendPosition="Hidden" />
                            <!-- Clean native WPF Arabic Legend -->
                            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
                                <StackPanel Orientation="Horizontal" Margin="14,0">
                                    <Border Width="10" Height="10" CornerRadius="5" Background="{StaticResource PrimaryBrush}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                    <TextBlock Text="المبيعات (ج.م)" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="14,0">
                                    <Border Width="10" Height="10" CornerRadius="5" Background="{StaticResource AccentBrush}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                    <TextBlock Text="الأرباح (ج.م)" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="المبيعات حسب طريقة الدفع"
                                       Style="{StaticResource CardTitleTextStyle}" />

                            <Grid Grid.Row="1" Height="230" Margin="0,8,0,0">
                                <lvc:PieChart FlowDirection="LeftToRight"
                                              Series="{Binding PaymentSeries}"
                                              LegendPosition="Hidden"
                                              TooltipPosition="Top" />
                                <TextBlock Text="لا توجد مبيعات في هذه الفترة"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="{StaticResource TextSecondaryBrush}" FontSize="12">
                                    <TextBlock.Style>
                                        <Style TargetType="{x:Type TextBlock}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasPaymentData}" Value="False">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>

                            <ItemsControl Grid.Row="2" ItemsSource="{Binding Analytics.PaymentBreakdown}"
                                          Margin="0,8,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding MethodName}" FontSize="12" />
                                            <TextBlock Grid.Column="1" Text="{Binding InvoiceCount}" FontSize="12"
                                                       Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,10,0" />
                                            <TextBlock Grid.Column="2" FontSize="12" FontWeight="SemiBold">
                                                <Run Text="{Binding Amount, Mode=OneWay, StringFormat='{}{0:N2}'}" />
                                                <Run Text="ج.م" />
                                            </TextBlock>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Categories + products -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" Margin="0,0,12,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="المبيعات حسب الأقسام"
                                       Style="{StaticResource CardTitleTextStyle}" />
                            <Grid Grid.Row="1" Height="270" Margin="0,8,0,0">
                                <lvc:CartesianChart FlowDirection="LeftToRight"
                                                    Series="{Binding CategorySeries}"
                                                    XAxes="{Binding CategoryXAxes}"
                                                    YAxes="{Binding CategoryYAxes}"
                                                    LegendPosition="Hidden" />
                                <TextBlock Text="لا توجد بيانات للأقسام في هذه الفترة"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="{StaticResource TextSecondaryBrush}" FontSize="12">
                                    <TextBlock.Style>
                                        <Style TargetType="{x:Type TextBlock}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasCategoryData}" Value="False">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </Grid>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="أفضل 8 منتجات (بالإيراد)"
                                       Style="{StaticResource CardTitleTextStyle}" />
                            <Grid Grid.Row="1" Height="270" Margin="0,8,0,0">
                                <lvc:CartesianChart FlowDirection="LeftToRight"
                                                    Series="{Binding TopProductSeries}"
                                                    XAxes="{Binding TopProductXAxes}"
                                                    YAxes="{Binding TopProductYAxes}"
                                                    LegendPosition="Hidden" />
                                <TextBlock Text="لا توجد مبيعات للمنتجات في هذه الفترة"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="{StaticResource TextSecondaryBrush}" FontSize="12">
                                    <TextBlock.Style>
                                        <Style TargetType="{x:Type TextBlock}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasTopProductData}" Value="False">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Tables -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" Margin="0,0,12,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="220" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="أداء الكاشيرين" Style="{StaticResource CardTitleTextStyle}" />
                            <DataGrid Grid.Row="1" ItemsSource="{Binding Analytics.Cashiers}" Margin="0,8,0,0">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="الكاشير" Binding="{Binding CashierName}" Width="*" />
                                    <DataGridTextColumn Header="الدور" Binding="{Binding RoleName}" Width="110" />
                                    <DataGridTextColumn Header="فواتير" Binding="{Binding InvoiceCount}" Width="80" />
                                    <DataGridTextColumn Header="المبيعات" Width="120"
                                                        Binding="{Binding Sales, StringFormat='{}{0:N2}'}" />
                                    <DataGridTextColumn Header="الربح" Width="110"
                                                        Binding="{Binding Profit, StringFormat='{}{0:N2}'}" />
                                    <DataGridTextColumn Header="ورديّات" Binding="{Binding ShiftCount}" Width="80" />
                                    <DataGridTextColumn Header="فرق النقدية" Width="110"
                                                        Binding="{Binding CashDifference, StringFormat='{}{0:N2}'}" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="220" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="قيمة المخزون حسب القسم" Style="{StaticResource CardTitleTextStyle}" />
                            <DataGrid Grid.Row="1" ItemsSource="{Binding Analytics.CategoryStock}" Margin="0,8,0,0">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="القسم" Binding="{Binding CategoryName}" Width="*" />
                                    <DataGridTextColumn Header="منتجات" Binding="{Binding ProductCount}" Width="90" />
                                    <DataGridTextColumn Header="نواقص" Binding="{Binding LowStockCount}" Width="90" />
                                    <DataGridTextColumn Header="الكمية" Width="110"
                                                        Binding="{Binding Quantity, StringFormat='{}{0:N2}'}" />
                                    <DataGridTextColumn Header="القيمة (ج.م)" Width="130"
                                                        Binding="{Binding StockValue, StringFormat='{}{0:N2}'}" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Invoices -->
                <Border Style="{StaticResource CardBorderStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="240" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="فواتير الفترة (آخر 100 فاتورة)"
                                       Style="{StaticResource CardTitleTextStyle}" />
                            <TextBlock Grid.Column="1" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                                       Text="انقر مرتين على الفاتورة لعرض تفاصيلها" />
                        </Grid>

                        <DataGrid x:Name="InvoiceGrid" Grid.Row="1" Margin="0,8,0,0"
                                  ItemsSource="{Binding Invoices}"
                                  SelectedItem="{Binding SelectedInvoiceRow}"
                                  MouseDoubleClick="OnInvoiceDoubleClick">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="رقم الفاتورة" Width="150"
                                                    Binding="{Binding InvoiceNumber, Converter={StaticResource RtlIsolation}}" />
                                <DataGridTextColumn Header="التاريخ والوقت" Width="140"
                                                    Binding="{Binding InvoiceDateUtc, StringFormat='{}{0:dd/MM/yyyy HH:mm}'}" />
                                <DataGridTextColumn Header="الكاشير" Binding="{Binding CashierName}" Width="*" />
                                <DataGridTextColumn Header="العميل" Binding="{Binding CustomerName}" Width="140" />
                                <DataGridTextColumn Header="طريقة الدفع" Binding="{Binding PaymentMethodName}" Width="110" />
                                <DataGridTextColumn Header="أصناف" Binding="{Binding ItemCount}" Width="70" />
                                <DataGridTextColumn Header="الإجمالي" Width="110"
                                                    Binding="{Binding TotalAmount, StringFormat='{}{0:N2}'}" />
                                <DataGridTextColumn Header="المدفوع" Width="110"
                                                    Binding="{Binding PaidAmount, StringFormat='{}{0:N2}'}" />
                                <DataGridTextColumn Header="الحالة" Binding="{Binding StatusName}" Width="100" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- ========================= Invoice detail overlay ======================= -->
        <Border Grid.Row="1" Background="#80000000"
                Visibility="{Binding SelectedInvoice, Converter={StaticResource NullToVisibility}}">
            <Border Background="{StaticResource SurfaceBrush}" CornerRadius="10"
                    MaxWidth="900" MaxHeight="640" Margin="40" Padding="18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Style="{StaticResource CardTitleTextStyle}">
                                <Run Text="تفاصيل الفاتورة " />
                                <Run Text="{Binding SelectedInvoice.Header.InvoiceNumber, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0">
                                <Run Text="{Binding SelectedInvoice.Header.InvoiceDateUtc, Mode=OneWay, StringFormat='{}{0:dd/MM/yyyy HH:mm}'}" />
                                <Run Text=" - الكاشير: " />
                                <Run Text="{Binding SelectedInvoice.Header.CashierName, Mode=OneWay}" />
                                <Run Text=" - الدفع: " />
                                <Run Text="{Binding SelectedInvoice.Header.PaymentMethodName, Mode=OneWay}" />
                            </TextBlock>
                        </StackPanel>
                        <Button Grid.Column="1" Content="✖" Width="40" Height="32"
                                Style="{StaticResource GhostButtonStyle}"
                                Command="{Binding CloseInvoiceCommand}" />
                    </Grid>

                    <DataGrid Grid.Row="1" Margin="0,12,0,0" ItemsSource="{Binding SelectedInvoice.Lines}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="الصنف" Binding="{Binding ProductName}" Width="*" />
                            <DataGridTextColumn Header="البار كود" Width="130"
                                                Binding="{Binding Barcode, Converter={StaticResource RtlIsolation}}" />
                            <DataGridTextColumn Header="الكمية" Width="80"
                                                Binding="{Binding Quantity, StringFormat='{}{0:N2}'}" />
                            <DataGridTextColumn Header="سعر الوحدة" Width="110"
                                                Binding="{Binding UnitPrice, StringFormat='{}{0:N2}'}" />
                            <DataGridTextColumn Header="الخصم" Width="90"
                                                Binding="{Binding DiscountAmount, StringFormat='{}{0:N2}'}" />
                            <DataGridTextColumn Header="الضريبة" Width="90"
                                                Binding="{Binding TaxAmount, StringFormat='{}{0:N2}'}" />
                            <DataGridTextColumn Header="الإجمالي" Width="110"
                                                Binding="{Binding LineTotalWithTax, StringFormat='{}{0:N2}'}" />
                            <DataGridTextColumn Header="الربح" Width="100"
                                                Binding="{Binding Profit, StringFormat='{}{0:N2}'}" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <Grid Grid.Row="2" Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" FontSize="18" FontWeight="Bold"
                                   Foreground="{StaticResource PrimaryBrush}" TextWrapping="Wrap">
                            <Run Text="الإجمالي: " />
                            <Run Text="{Binding SelectedInvoice.Header.TotalAmount, Mode=OneWay, StringFormat='{}{0:N2}'}" />
                            <Run Text="ج.م" />
                            <Run Text="   -   المدفوع: " />
                            <Run Text="{Binding SelectedInvoice.Header.PaidAmount, Mode=OneWay, StringFormat='{}{0:N2}'}" />
                            <Run Text="ج.م" />
                            <Run Text="   -   المتبقي: " />
                            <Run Text="{Binding SelectedInvoice.ChangeAmount, Mode=OneWay, StringFormat='{}{0:N2}'}" />
                            <Run Text="ج.م" />
                        </TextBlock>

                        <TextBlock Grid.Column="1" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                                   Text="{Binding SelectedInvoice.Notes}" TextWrapping="Wrap" MaxWidth="240" />
                    </Grid>
                </Grid>
            </Border>
        </Border>

        <!-- ============================== Footer =============================== -->
        <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0"
                Padding="14,8" Margin="0,12,0,-12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}">
                    <Run Text="الفترة: " />
                    <Run Text="{Binding PeriodText, Mode=OneWay}" />
                    <Run Text="   |   " />
                    <Run Text="{Binding StatusMessage, Mode=OneWay}" />
                </TextBlock>

                <ProgressBar Grid.Column="1" Width="140" Height="6" IsIndeterminate="{Binding IsBusy}"
                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}"
                             Foreground="{StaticResource PrimaryBrush}" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
