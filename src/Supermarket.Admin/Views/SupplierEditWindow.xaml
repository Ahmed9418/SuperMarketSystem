<Window x:Class="Supermarket.Admin.Views.SupplierEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}"
        Height="620" Width="720"
        FlowDirection="RightToLeft"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{StaticResource CanvasBrush}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{Binding Title}" Style="{StaticResource PageTitleTextStyle}" Margin="0,0,0,16" />

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,12">
                    <TextBlock Text="اسم المورد *" Style="{StaticResource FieldLabelTextStyle}" />
                    <TextBox Text="{Binding SupplierName, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>

                <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,12">
                    <TextBlock Text="مسؤول التواصل" Style="{StaticResource FieldLabelTextStyle}" />
                    <TextBox Text="{Binding ContactPerson, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,12">
                    <TextBlock Text="رقم الهاتف" Style="{StaticResource FieldLabelTextStyle}" />
                    <TextBox Text="{Binding PhoneNumber, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,12">
                    <TextBlock Text="البريد الإلكتروني" Style="{StaticResource FieldLabelTextStyle}" />
                    <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>

                <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,0,12">
                    <TextBlock Text="الرقم الضريبي" Style="{StaticResource FieldLabelTextStyle}" />
                    <TextBox Text="{Binding TaxNumber, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>

                <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,0,0,12">
                    <TextBlock Text="الرصيد (ج.م)" Style="{StaticResource FieldLabelTextStyle}" />
                    <TextBox Text="{Binding Balance, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:N2}}" />
                </StackPanel>

                <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,0,0,12">
                    <TextBlock Text="العنوان" Style="{StaticResource FieldLabelTextStyle}" />
                    <TextBox Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>

                <StackPanel Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,0,0,12">
                    <TextBlock Text="ملاحظات" Style="{StaticResource FieldLabelTextStyle}" />
                    <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"
                             Height="80" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" />
                </StackPanel>

                <CheckBox Grid.Row="5" Grid.Column="0" Content="مورد نشط" IsChecked="{Binding IsActive}"
                          FlowDirection="RightToLeft" VerticalContentAlignment="Center" Margin="0,6,0,0" />
            </Grid>
        </ScrollViewer>

        <Grid Grid.Row="2" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="{Binding ErrorMessage}"
                       Foreground="{StaticResource DangerBrush}"
                       TextWrapping="Wrap" VerticalAlignment="Center"
                       Visibility="{Binding ErrorMessage, Converter={StaticResource EmptyStringToVisibility}}" />

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="حفظ" Width="120" Command="{Binding SaveCommand}" IsDefault="True" />
                <Button Content="إلغاء" Width="110" Margin="8,0,0,0"
                        Style="{StaticResource GhostButtonStyle}"
                        IsCancel="True" Click="OnCancelClick" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
