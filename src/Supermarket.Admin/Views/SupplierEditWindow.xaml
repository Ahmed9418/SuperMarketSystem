<Window x:Class="Supermarket.Admin.Views.SupplierEditWindow"
        Style="{StaticResource AppWindowStyle}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}"
        Height="620" Width="720"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{StaticResource CanvasBrush}">

    <Window.Resources>
        <Style x:Key="FormLabelStyle" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource FieldLabelTextStyle}">
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{Binding Title}" Style="{StaticResource PageTitleTextStyle}"
                   Margin="0,0,0,16" />

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,12">
                    <TextBlock Text="اسم المورد *" Style="{StaticResource FormLabelStyle}" />
                    <TextBox Text="{Binding SupplierName, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>

                <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,12">
                    <TextBlock Text="مسؤول التواصل" Style="{StaticResource FormLabelStyle}" />
                    <TextBox Text="{Binding ContactPerson, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,12">
                    <TextBlock Text="رقم الهاتف" Style="{StaticResource FormLabelStyle}" />
                    <TextBox Style="{StaticResource LatinInputStyle}"
                             Text="{Binding PhoneNumber, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,12">
                    <TextBlock Text="البريد الإلكتروني" Style="{StaticResource FormLabelStyle}" />
                    <TextBox Style="{StaticResource LatinInputStyle}"
                             Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>

                <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,0,12">
                    <TextBlock Text="رصيد لنا (ج.م)" Style="{StaticResource FormLabelStyle}" />
                    <TextBox Style="{StaticResource NumericInputStyle}"
                             Text="{Binding DebitBalance, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:N2}}" />
                </StackPanel>

                <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,0,0,12">
                    <TextBlock Text="رصيد علينا (ج.م)" Style="{StaticResource FormLabelStyle}" />
                    <TextBox Style="{StaticResource NumericInputStyle}"
                             Text="{Binding CreditBalance, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:N2}}" />
                </StackPanel>

                <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,0,0,12">
                    <TextBlock Text="العنوان" Style="{StaticResource FormLabelStyle}" />
                    <TextBox Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>

                <StackPanel Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,0,0,12">
                    <TextBlock Text="ملاحظات" Style="{StaticResource FormLabelStyle}" />
                    <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"
                             Height="80" AcceptsReturn="True" TextWrapping="Wrap"
                             VerticalContentAlignment="Top" />
                </StackPanel>

                <CheckBox Grid.Row="5" Grid.Column="0" Content="مورد نشط" IsChecked="{Binding IsActive}"
                          VerticalContentAlignment="Center" Margin="0,6,0,0" />
            </Grid>
        </ScrollViewer>

        <Grid Grid.Row="2" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="{Binding ErrorMessage}"
                       Style="{StaticResource ErrorTextStyle}" Margin="0" VerticalAlignment="Center" />

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="حفظ" Width="120" IsDefault="True" Command="{Binding SaveCommand}" />
                <Button Content="إلغاء" Width="110" Margin="8,0,0,0"
                        Style="{StaticResource GhostButtonStyle}"
                        IsCancel="True" Click="OnCancelClick" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>