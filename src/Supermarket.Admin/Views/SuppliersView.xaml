<UserControl x:Class="Supermarket.Admin.Views.SuppliersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Border Grid.Row="0" Style="{StaticResource CardBorderStyle}" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Text="بحث باسم المورد أو الهاتف" Style="{StaticResource FieldLabelTextStyle}" />
                        <TextBox Width="300"
                                 Text="{Binding SearchTerm, UpdateSourceTrigger=PropertyChanged, Delay=100}"
                                 KeyDown="OnSearchKeyDown" />
                    </StackPanel>
                    <Button Content="بحث" VerticalAlignment="Bottom" Width="90"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding LoadCommand}" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                    <Button Content="➕ مورد جديد" Width="130"
                            Command="{Binding OpenEditorCommand}"
                            CommandParameter="{x:Null}" />
                    <Button Content="✏ تعديل المورد المحدد" Width="170" Margin="8,0,0,0"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding OpenEditorCommand}"
                            CommandParameter="{Binding SelectedSupplier}" />
                    <Button Content="⏻ تفعيل / إيقاف" Width="140" Margin="8,0,0,0"
                            Style="{StaticResource WarningButtonStyle}"
                            Command="{Binding ToggleActiveCommand}"
                            CommandParameter="{Binding SelectedSupplier}" />
                    <Button Content="🗑 حذف المورد"
                            Width="140" Margin="8,0,0,0"
                            Style="{StaticResource DangerButtonStyle}"
                            IsEnabled="{Binding CanEdit}"
                            ToolTip="حذف المورد المحدد (تُفك ارتباطه بالمنتجات)"
                            Command="{Binding DeleteCommand}"
                            CommandParameter="{Binding SelectedSupplier}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Grid -->
        <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <DataGrid Grid.Row="0"
                          ItemsSource="{Binding Suppliers}"
                          SelectedItem="{Binding SelectedSupplier}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="اسم المورد" Binding="{Binding Name}" Width="*" MinWidth="180" />
                        <DataGridTextColumn Header="مسؤول التواصل" Binding="{Binding ContactPerson}" Width="150" />
                        <DataGridTextColumn Header="الهاتف" Binding="{Binding PhoneNumber}" Width="130" />
                        <DataGridTextColumn Header="العنوان" Binding="{Binding Address}" Width="200" />
                        <DataGridTextColumn Header="الرقم الضريبي" Binding="{Binding TaxNumber}" Width="120" />
                        <DataGridTextColumn Header="عدد المنتجات" Binding="{Binding ProductCount}" Width="110" />
                        <DataGridTextColumn Header="الرصيد"
                                            Binding="{Binding Balance, Converter={StaticResource EgpCurrency}}"
                                            Width="130" />
                        <DataGridCheckBoxColumn Header="نشط" Binding="{Binding IsActive}" Width="70" />
                    </DataGrid.Columns>
                </DataGrid>

                <TextBlock Grid.Row="1" Text="{Binding StatusMessage}" Margin="12,8"
                           Foreground="{StaticResource TextSecondaryBrush}" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
