<UserControl x:Class="Supermarket.Admin.Views.StockMovementsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ============================== Filters ============================== -->
        <Border Grid.Row="0" Style="{StaticResource CardBorderStyle}" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="حركة المخزون (كارت الصنف)" Style="{StaticResource PageTitleTextStyle}" Margin="0,0,0,12" />

                <WrapPanel>
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Text="بحث باسم المنتج أو البار كود" Style="{StaticResource FieldLabelTextStyle}" />
                        <TextBox Width="240" Text="{Binding SearchTerm, UpdateSourceTrigger=PropertyChanged, Delay=150}" />
                    </StackPanel>

                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Text="نوع الحركة" Style="{StaticResource FieldLabelTextStyle}" />
                        <ComboBox Width="170"
                                  ItemsSource="{Binding MovementTypes}"
                                  DisplayMemberPath="Caption"
                                  SelectedItem="{Binding SelectedMovementType}" />
                    </StackPanel>

                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Text="من تاريخ" Style="{StaticResource FieldLabelTextStyle}" />
                        <DatePicker Width="150" SelectedDate="{Binding FromDate}" />
                    </StackPanel>

                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Text="إلى تاريخ" Style="{StaticResource FieldLabelTextStyle}" />
                        <DatePicker Width="150" SelectedDate="{Binding ToDate}" />
                    </StackPanel>

                    <StackPanel VerticalAlignment="Bottom" Margin="0,0,12,0">
                        <CheckBox Content="الوارد فقط" IsChecked="{Binding InboundOnly}"
                                  FlowDirection="RightToLeft" Height="20" Margin="0,0,0,4" />
                        <CheckBox Content="الصادر فقط" IsChecked="{Binding OutboundOnly}"
                                  FlowDirection="RightToLeft" Height="20" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                        <Button Content="🔍 بحث" Width="100" Command="{Binding SearchCommand}" />
                        <Button Content="مسح الفلاتر" Width="110" Margin="8,0,0,0"
                                Style="{StaticResource GhostButtonStyle}"
                                Command="{Binding ClearFiltersCommand}" />
                    </StackPanel>
                </WrapPanel>
            </StackPanel>
        </Border>

        <!-- ============================== Totals ============================== -->
        <UniformGrid Grid.Row="1" Columns="3" Margin="0,0,0,12">
            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,12,0" Padding="12">
                <StackPanel>
                    <TextBlock Text="قيمة الوارد (بسعر التكلفة)" Style="{StaticResource FieldLabelTextStyle}" />
                    <TextBlock Text="{Binding TotalInboundValue, Converter={StaticResource EgpCurrency}}"
                               FontSize="20" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,12,0" Padding="12">
                <StackPanel>
                    <TextBlock Text="قيمة الصادر (بسعر التكلفة)" Style="{StaticResource FieldLabelTextStyle}" />
                    <TextBlock Text="{Binding TotalOutboundValue, Converter={StaticResource EgpCurrency}}"
                               FontSize="20" FontWeight="Bold" Foreground="{StaticResource DangerBrush}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardBorderStyle}" Padding="12">
                <StackPanel>
                    <TextBlock Text="عدد الحركات في الصفحة الحالية" Style="{StaticResource FieldLabelTextStyle}" />
                    <TextBlock Text="{Binding Movements.Count, StringFormat={}{0:N0}}"
                               FontSize="20" FontWeight="Bold" Foreground="{StaticResource PrimaryDarkBrush}" />
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- =============================== Grid =============================== -->
        <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}" Padding="0">
            <DataGrid ItemsSource="{Binding Movements}">
                <DataGrid.RowStyle>
                    <Style TargetType="{x:Type DataGridRow}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsInbound}" Value="True">
                                <Setter Property="Background" Value="{StaticResource SuccessLightBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="التاريخ"
                                        Binding="{Binding CreatedAtUtc, StringFormat={}{0:dd/MM/yyyy HH:mm}}"
                                        Width="140" />
                    <DataGridTextColumn Header="اسم المنتج" Binding="{Binding ProductName}" Width="*" MinWidth="200" />
                    <DataGridTextColumn Header="البار كود" Binding="{Binding Barcode}" Width="140" />
                    <DataGridTextColumn Header="نوع الحركة" Binding="{Binding MovementTypeArabic}" Width="120" />
                    <DataGridTextColumn Header="الكمية" Width="100"
                                        Binding="{Binding Quantity, StringFormat={}{0:N2}}" />
                    <DataGridTextColumn Header="الرصيد بعد الحركة" Width="130"
                                        Binding="{Binding BalanceAfter, StringFormat={}{0:N2}}" />
                    <DataGridTextColumn Header="قيمة الحركة"
                                        Binding="{Binding MovementValue, Converter={StaticResource EgpCurrency}}"
                                        Width="130" />
                    <DataGridTextColumn Header="المستند" Binding="{Binding ReferenceNumber}" Width="130" />
                    <DataGridTextColumn Header="السبب" Binding="{Binding Reason}" Width="200" />
                    <DataGridTextColumn Header="بواسطة" Binding="{Binding PerformedBy}" Width="110" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- ============================== Footer ============================== -->
        <Grid Grid.Row="3" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="{Binding StatusMessage}"
                       Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="السابق" Style="{StaticResource SecondaryButtonStyle}" Width="90"
                        IsEnabled="{Binding HasPreviousPage}"
                        Command="{Binding PreviousPageCommand}" />
                <TextBlock Text="{Binding PageNumber, StringFormat='صفحة {0}'}" Margin="12,0" VerticalAlignment="Center" />
                <Button Content="التالي" Style="{StaticResource SecondaryButtonStyle}" Width="90"
                        IsEnabled="{Binding HasNextPage}"
                        Command="{Binding NextPageCommand}" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
