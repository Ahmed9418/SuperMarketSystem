<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        ============================================================================
        POS theme: the light "Modern Blue" palette of the admin application, scaled
        up for a touch screen (44 px minimum, 60+ px for the F-key chips).

        RTL RULE: FlowDirection = RightToLeft is declared ONCE, on the Window style.
        Controls inherit it. Use FlowDirection="LeftToRight" only for Latin content
        (barcode, user name) and for the monospace receipt preview.
        ============================================================================
    -->

    <FontFamily x:Key="PosFontFamily">Segoe UI, Tahoma, Arial</FontFamily>
    <FontFamily x:Key="PosMonoFontFamily">Consolas, Tahoma</FontFamily>

    <!-- Surfaces -->
    <SolidColorBrush x:Key="PosBackgroundBrush" Color="#F4F6FB" />
    <SolidColorBrush x:Key="PosPanelBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="PosSurfaceBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="PosSidebarBrush" Color="#0F172A" />
    <SolidColorBrush x:Key="PosHeaderBrush" Color="#0F172A" />

    <!-- Accents -->
    <SolidColorBrush x:Key="PosAccentBrush" Color="#1D4ED8" />
    <SolidColorBrush x:Key="PosAccentDarkBrush" Color="#1E3A8A" />
    <SolidColorBrush x:Key="PosAccentLightBrush" Color="#EFF6FF" />
    <SolidColorBrush x:Key="PosAccentMidBrush" Color="#3B82F6" />
    <SolidColorBrush x:Key="PosDangerBrush" Color="#DC2626" />
    <SolidColorBrush x:Key="PosWarningBrush" Color="#D97706" />
    <SolidColorBrush x:Key="PosSuccessBrush" Color="#059669" />

    <!-- Text on light surfaces -->
    <SolidColorBrush x:Key="PosTextBrush" Color="#111827" />
    <SolidColorBrush x:Key="PosMutedTextBrush" Color="#5B6675" />
    <SolidColorBrush x:Key="PosBorderBrush" Color="#DDE3EE" />

    <!-- Text on the dark header / sidebar -->
    <SolidColorBrush x:Key="PosOnDarkTextBrush" Color="#E8EEF9" />
    <SolidColorBrush x:Key="PosOnDarkMutedBrush" Color="#B6C4DA" />
    <SolidColorBrush x:Key="PosSidebarHoverBrush" Color="#1E293B" />
    <SolidColorBrush x:Key="PosSidebarPressedBrush" Color="#172554" />
    <SolidColorBrush x:Key="PosDividerBrush" Color="#24324A" />

    <!-- Soft tints for badges and row highlights -->
    <SolidColorBrush x:Key="PosTableStripeBrush" Color="#F8FAFC" />
    <SolidColorBrush x:Key="PosDangerLightBrush" Color="#FEE2E2" />
    <SolidColorBrush x:Key="PosWarningLightBrush" Color="#FEF3C7" />
    <SolidColorBrush x:Key="PosWarningDarkBrush" Color="#92400E" />
    <SolidColorBrush x:Key="PosSuccessLightBrush" Color="#DCFCE7" />
    <SolidColorBrush x:Key="PosSuccessDarkBrush" Color="#065F46" />

    <!-- ============================================================== Window -->
    <!--
        Keyed so a derived window can opt in:  Style="{StaticResource AppWindowStyle}".
        An implicit style is matched by EXACT type, and every window here is a derived class,
        so ArabicLayout.PinWindowStyle() also binds this style to each window type.
    -->
    <Style x:Key="AppWindowStyle" TargetType="{x:Type Window}">
        <Setter Property="FlowDirection" Value="RightToLeft" />
        <Setter Property="FontFamily" Value="{StaticResource PosFontFamily}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Background" Value="{StaticResource PosBackgroundBrush}" />
        <Setter Property="Foreground" Value="{StaticResource PosTextBrush}" />
        <Setter Property="UseLayoutRounding" Value="True" />
    </Style>

    <Style TargetType="{x:Type Window}" BasedOn="{StaticResource AppWindowStyle}" />

    <!-- No Foreground setter here: an implicit TextBlock style also hits the TextBlock a
         ContentPresenter creates for string content, which would override the inherited colour
         (dark text on navy headers and inside buttons). The Window style owns the default colour. -->
    <Style TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="{StaticResource PosFontFamily}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- =============================================================== Inputs -->
    <Style TargetType="{x:Type TextBox}">
        <Setter Property="FontFamily" Value="{StaticResource PosFontFamily}" />
        <Setter Property="Height" Value="46" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Background" Value="{StaticResource PosSurfaceBrush}" />
        <Setter Property="Foreground" Value="{StaticResource PosTextBrush}" />
        <Setter Property="CaretBrush" Value="{StaticResource PosTextBrush}" />
        <Setter Property="SelectionBrush" Value="{StaticResource PosAccentBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource PosBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Style.Triggers>
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource PosAccentBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Latin / numeric input: scanner codes and typed amounts read left to right. -->
    <Style x:Key="PosLatinInputStyle" TargetType="{x:Type TextBox}" BasedOn="{StaticResource {x:Type TextBox}}">
        <Setter Property="FlowDirection" Value="LeftToRight" />
        <Setter Property="TextAlignment" Value="Left" />
        <Setter Property="FontFamily" Value="{StaticResource PosMonoFontFamily}" />
    </Style>

    <Style TargetType="{x:Type PasswordBox}">
        <Setter Property="Height" Value="46" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="Background" Value="{StaticResource PosSurfaceBrush}" />
        <Setter Property="Foreground" Value="{StaticResource PosTextBrush}" />
        <Setter Property="CaretBrush" Value="{StaticResource PosTextBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource PosBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <!-- Latin password / PIN: typed left to right so the dots and digits do not jump.
         PasswordBox has NO TextAlignment property; the alignment follows FlowDirection. -->
    <Style x:Key="PosLatinPasswordStyle" TargetType="{x:Type PasswordBox}" BasedOn="{StaticResource {x:Type PasswordBox}}">
        <Setter Property="FlowDirection" Value="LeftToRight" />
        <Setter Property="FontFamily" Value="{StaticResource PosMonoFontFamily}" />
    </Style>

    <Style TargetType="{x:Type ComboBox}">
        <Setter Property="FontFamily" Value="{StaticResource PosFontFamily}" />
        <Setter Property="Height" Value="44" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{StaticResource PosTextBrush}" />
        <Setter Property="Background" Value="{StaticResource PosSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource PosBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style TargetType="{x:Type ComboBoxItem}">
        <Setter Property="FontFamily" Value="{StaticResource PosFontFamily}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="Padding" Value="8,6" />
    </Style>

    <Style TargetType="{x:Type CheckBox}">
        <Setter Property="FontFamily" Value="{StaticResource PosFontFamily}" />
        <Setter Property="Foreground" Value="{StaticResource PosTextBrush}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <!-- ================================================================ Grids -->
    <Style TargetType="{x:Type DataGridRow}">
        <Setter Property="Foreground" Value="{StaticResource PosTextBrush}" />
        <Setter Property="Background" Value="{StaticResource PosSurfaceBrush}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource PosAccentLightBrush}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{StaticResource PosAccentBrush}" />
                <Setter Property="Foreground" Value="White" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="{x:Type DataGrid}">
        <Setter Property="FontFamily" Value="{StaticResource PosFontFamily}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Background" Value="{StaticResource PosSurfaceBrush}" />
        <Setter Property="Foreground" Value="{StaticResource PosTextBrush}" />
        <Setter Property="RowBackground" Value="{StaticResource PosSurfaceBrush}" />
        <Setter Property="AlternatingRowBackground" Value="{StaticResource PosTableStripeBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource PosBorderBrush}" />
        <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource PosBorderBrush}" />
        <Setter Property="VerticalGridLinesBrush" Value="{StaticResource PosBorderBrush}" />
        <Setter Property="ColumnHeaderHeight" Value="42" />
        <Setter Property="AutoGenerateColumns" Value="False" />
        <Setter Property="CanUserAddRows" Value="False" />
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="SelectionMode" Value="Single" />
    </Style>

    <Style TargetType="{x:Type DataGridColumnHeader}">
        <Setter Property="Background" Value="{StaticResource PosAccentDarkBrush}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="BorderBrush" Value="{StaticResource PosAccentBrush}" />
        <Setter Property="BorderThickness" Value="0,0,1,1" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type DataGridColumnHeader}">
                    <Border x:Name="HeaderBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="HeaderBorder" Property="Background" Value="{StaticResource PosAccentBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================== Buttons -->
    <Style TargetType="{x:Type Button}">
        <Setter Property="FontFamily" Value="{StaticResource PosFontFamily}" />
        <Setter Property="FontSize" Value="17" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Height" Value="52" />
        <Setter Property="Padding" Value="18,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Background" Value="{StaticResource PosAccentBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.9" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.75" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Light chip used for the "secondary" actions that must not compete with the primary one. -->
    <Style x:Key="PosLightButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{StaticResource PosPanelBrush}" />
        <Setter Property="Foreground" Value="{StaticResource PosTextBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource PosBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <!-- F-key shortcut chip -->
    <Style x:Key="FunctionButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Height" Value="64" />
        <Setter Property="Margin" Value="4" />
        <Setter Property="Background" Value="{StaticResource PosAccentLightBrush}" />
        <Setter Property="Foreground" Value="{StaticResource PosAccentDarkBrush}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="BorderBrush" Value="{StaticResource PosBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style x:Key="DangerButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{StaticResource PosDangerBrush}" />
        <Setter Property="Foreground" Value="White" />
    </Style>

    <!-- =========================================================== Typography -->
    <Style x:Key="TotalLabelStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="Foreground" Value="{StaticResource PosMutedTextBrush}" />
        <Setter Property="Margin" Value="0,4" />
    </Style>

    <Style x:Key="TotalValueStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Foreground" Value="{StaticResource PosTextBrush}" />
    </Style>

    <Style x:Key="GrandTotalValueStyle" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource TotalValueStyle}">
        <Setter Property="FontSize" Value="34" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{StaticResource PosAccentBrush}" />
    </Style>

</ResourceDictionary>
