<Window x:Class="Supermarket.POS.Views.InputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Height="250" Width="520"
        FlowDirection="RightToLeft"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{StaticResource PosPanelBrush}">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="MessageText" Grid.Row="0" TextWrapping="Wrap"
                   Foreground="{StaticResource PosTextBrush}" FontSize="17"
                   VerticalAlignment="Top" />

        <TextBox x:Name="InputBox" Grid.Row="1" FontSize="22" Height="56"
                 Margin="0,0,0,16" />

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Left">
            <Button Content="موافق" Width="130" IsDefault="True" Click="OnOkClick" />
            <Button Content="إلغاء" Width="120" Margin="8,0,0,0" IsCancel="True"
                    Background="{StaticResource PosDangerBrush}" Click="OnCancelClick" />
        </StackPanel>
    </Grid>
</Window>
