<Window x:Class="Supermarket.POS.Views.InputDialog"
        Style="{StaticResource AppWindowStyle}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Height="270" Width="560"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{StaticResource PosPanelBrush}">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="MessageText" Grid.Row="0" TextWrapping="Wrap"
                   Foreground="{StaticResource PosTextBrush}" FontSize="17"
                   VerticalAlignment="Top" />

        <!-- Latin digits only: amounts and quantities always read left to right. -->
        <TextBox x:Name="InputBox" Grid.Row="1" FontSize="22" Height="56"
                 Margin="0,0,0,16"
                 FlowDirection="LeftToRight" TextAlignment="Left"
                 FontFamily="{StaticResource PosMonoFontFamily}" />

        <!-- In an RTL layout the first button of a horizontal stack sits on the right. -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Left">
            <Button Content="موافق" Width="130" IsDefault="True" Click="OnOkClick" />
            <Button Content="إلغاء" Width="120" Margin="8,0,0,0" IsCancel="True"
                    Background="{StaticResource PosDangerBrush}" Click="OnCancelClick" />
        </StackPanel>
    </Grid>
</Window>
