<Window x:Class="Supermarket.POS.Views.PaymentWindow"
        Style="{StaticResource AppWindowStyle}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="الدفع"
        Height="760" Width="1080"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{StaticResource PosBackgroundBrush}">

    <Window.Resources>
        <!-- Numeric keypad: white card with a border so it reads as a key, not as a primary action. -->
        <Style x:Key="KeypadButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource PosLightButtonStyle}">
            <Setter Property="Height" Value="58" />
            <Setter Property="Margin" Value="4" />
            <Setter Property="FontSize" Value="22" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <!-- Quick-cash chips: accent fill, white text (high contrast for touch). -->
        <Style x:Key="QuickCashButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Height" Value="52" />
            <Setter Property="Margin" Value="4" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Background" Value="{StaticResource PosAccentBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="420" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ====================== RIGHT: totals + summary ====================== -->
        <Border Grid.Column="0" Grid.Row="0" Background="{StaticResource PosPanelBrush}"
                CornerRadius="12" Padding="22" Margin="0,0,12,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="الإجمالي المستحق" FontSize="17"
                           Foreground="{StaticResource PosMutedTextBrush}" HorizontalAlignment="Center" />
                <TextBlock Grid.Row="1" Text="{Binding TotalText}" FontSize="52" FontWeight="Bold"
                           Foreground="{StaticResource PosAccentBrush}" HorizontalAlignment="Center"
                           Margin="0,4,0,0" />

                <TextBlock Grid.Row="2" HorizontalAlignment="Center" Margin="0,2,0,18" FontSize="15"
                           Foreground="{StaticResource PosMutedTextBrush}">
                    <Run Text="طريقة الدفع:" />
                    <Run Text="{Binding SelectedMethodName, Mode=OneWay}" FontWeight="SemiBold" />
                </TextBlock>

                <Grid Grid.Row="3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="المجموع الفرعي" Style="{StaticResource TotalLabelStyle}" />
                    <TextBlock Grid.Column="1" Text="{Binding Totals.SubTotal, StringFormat={}{0:N2} ج.م}"
                               Style="{StaticResource TotalValueStyle}" />
                </Grid>

                <Grid Grid.Row="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="الخصم" Style="{StaticResource TotalLabelStyle}" />
                    <TextBlock Grid.Column="1" Text="{Binding DiscountText}" Style="{StaticResource TotalValueStyle}"
                               Foreground="{StaticResource PosWarningBrush}" />
                </Grid>

                <StackPanel Grid.Row="5" VerticalAlignment="Center" Margin="0,20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="المدفوع" FontSize="20"
                                   Foreground="{StaticResource PosMutedTextBrush}" />
                        <TextBlock Grid.Column="1" Text="{Binding PaidText}" FontSize="30" FontWeight="Bold" />
                    </Grid>

                    <Rectangle Height="1" Fill="{StaticResource PosBorderBrush}" Margin="0,14" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="المتبقي" FontSize="20"
                                   Foreground="{StaticResource PosMutedTextBrush}" />
                        <TextBlock Grid.Column="1" Text="{Binding ChangeText}" FontSize="30" FontWeight="Bold"
                                   Foreground="{StaticResource PosAccentBrush}" />
                    </Grid>
                </StackPanel>

                <Border Grid.Row="6" Background="{StaticResource PosWarningLightBrush}" CornerRadius="8"
                        Padding="12" BorderBrush="{StaticResource PosWarningBrush}" BorderThickness="1">
                    <TextBlock Text="المتبقي = المبلغ المدفوع − الإجمالي. في البيع الآجل يُسجل المبلغ بالكامل على حساب العميل."
                               FontSize="12" TextWrapping="Wrap"
                               Foreground="{StaticResource PosMutedTextBrush}" />
                </Border>
            </Grid>
        </Border>

        <!-- ========================= LEFT: payment input ======================= -->
        <Border Grid.Column="1" Grid.Row="0" Background="{StaticResource PosPanelBrush}"
                CornerRadius="12" Padding="18">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Payment method -->
                <StackPanel Grid.Row="0">
                    <TextBlock Text="طريقة الدفع" FontSize="14"
                               Foreground="{StaticResource PosMutedTextBrush}" Margin="0,0,0,6" />
                    <ItemsControl ItemsSource="{Binding Methods}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="4" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding Caption}"
                                        Height="56" Margin="4" FontSize="17"
                                        Command="{Binding DataContext.SelectMethodCommand,
                                                          RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- Customer (needed for credit) -->
                <StackPanel Grid.Row="1" Margin="0,14,0,0">
                    <TextBlock Text="العميل (مطلوب للبيع الآجل)" FontSize="14"
                               Foreground="{StaticResource PosMutedTextBrush}" Margin="0,0,0,6" />
                    <ComboBox ItemsSource="{Binding Customers}"
                              DisplayMemberPath="Name"
                              SelectedItem="{Binding SelectedCustomer}"
                              Height="46" FontSize="16" />

                    <!-- Only needed for a credit sale: a walk-in name and phone on the invoice. -->
                    <Grid Margin="0,8,0,0"
                          Visibility="{Binding IsCredit, Converter={StaticResource BoolToVisibility}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Margin="0,0,6,0"
                                 Text="{Binding NewCustomerName, UpdateSourceTrigger=PropertyChanged}"
                                 Height="44" FontSize="15"
                                 ToolTip="اسم عميل جديد (اختياري)" />
                        <TextBox Grid.Column="1" Margin="6,0,0,0"
                                 Text="{Binding NewCustomerPhone, UpdateSourceTrigger=PropertyChanged}"
                                 Height="44" FontSize="15"
                                 FlowDirection="LeftToRight" TextAlignment="Left"
                                 FontFamily="{StaticResource PosMonoFontFamily}"
                                 ToolTip="رقم هاتف العميل (اختياري)" />
                    </Grid>

                    <TextBlock Text="اسم عميل جديد / رقم الهاتف" FontSize="12" Margin="0,6,0,0"
                               Foreground="{StaticResource PosMutedTextBrush}"
                               Visibility="{Binding IsCredit, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>

                <!-- Quick cash -->
                <StackPanel Grid.Row="2" Margin="0,14,0,0"
                            Visibility="{Binding IsCredit, Converter={StaticResource BoolToVisibilityInverse}}">
                    <TextBlock Text="مبالغ سريعة" FontSize="14"
                               Foreground="{StaticResource PosMutedTextBrush}" Margin="0,0,0,6" />
                    <ItemsControl ItemsSource="{Binding QuickCashOptions}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="6" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding Caption}" Style="{StaticResource QuickCashButtonStyle}"
                                        Command="{Binding DataContext.SetPaidAmountCommand,
                                                          RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- Keypad -->
                <Grid Grid.Row="3" Margin="0,12,0,0"
                      Visibility="{Binding IsCredit, Converter={StaticResource BoolToVisibilityInverse}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="200" />
                    </Grid.ColumnDefinitions>

                    <UniformGrid Grid.Column="0" Columns="3">
                        <Button Content="7" Style="{StaticResource KeypadButtonStyle}" Command="{Binding AppendDigitCommand}" CommandParameter="7" />
                        <Button Content="8" Style="{StaticResource KeypadButtonStyle}" Command="{Binding AppendDigitCommand}" CommandParameter="8" />
                        <Button Content="9" Style="{StaticResource KeypadButtonStyle}" Command="{Binding AppendDigitCommand}" CommandParameter="9" />
                        <Button Content="4" Style="{StaticResource KeypadButtonStyle}" Command="{Binding AppendDigitCommand}" CommandParameter="4" />
                        <Button Content="5" Style="{StaticResource KeypadButtonStyle}" Command="{Binding AppendDigitCommand}" CommandParameter="5" />
                        <Button Content="6" Style="{StaticResource KeypadButtonStyle}" Command="{Binding AppendDigitCommand}" CommandParameter="6" />
                        <Button Content="1" Style="{StaticResource KeypadButtonStyle}" Command="{Binding AppendDigitCommand}" CommandParameter="1" />
                        <Button Content="2" Style="{StaticResource KeypadButtonStyle}" Command="{Binding AppendDigitCommand}" CommandParameter="2" />
                        <Button Content="3" Style="{StaticResource KeypadButtonStyle}" Command="{Binding AppendDigitCommand}" CommandParameter="3" />
                        <Button Content="0" Style="{StaticResource KeypadButtonStyle}" Command="{Binding AppendDigitCommand}" CommandParameter="0" />
                        <Button Content="00" Style="{StaticResource KeypadButtonStyle}" Command="{Binding AppendDigitCommand}" CommandParameter="00" />
                        <Button Content="." Style="{StaticResource KeypadButtonStyle}" Command="{Binding AddDecimalCommand}" />
                    </UniformGrid>

                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                        <Button Content="مسح" Height="58" Margin="4"
                                Background="{StaticResource PosWarningBrush}"
                                Command="{Binding ClearPaidCommand}" />
                        <Button Content="الإجمالي" Height="58" Margin="4"
                                Style="{StaticResource PosLightButtonStyle}"
                                Command="{Binding SetExactPaidCommand}" />
                        <TextBlock Text="أدخل المبلغ المستلم من العميل" TextWrapping="Wrap"
                                   FontSize="12" Margin="6,10,6,0"
                                   Foreground="{StaticResource PosMutedTextBrush}" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- ============================== Footer ============================== -->
        <Grid Grid.Row="1" Grid.ColumnSpan="2" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="{Binding ErrorMessage}"
                       Foreground="{StaticResource PosDangerBrush}" FontSize="15"
                       TextWrapping="Wrap" VerticalAlignment="Center" />

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="✔ تأكيد الدفع" Width="220" Height="64" FontSize="20"
                        IsDefault="True" IsEnabled="{Binding CanConfirm}"
                        Command="{Binding ConfirmCommand}" />
                <Button Content="إلغاء" Width="140" Height="64" FontSize="16" Margin="10,0,0,0"
                        Background="{StaticResource PosDangerBrush}"
                        IsCancel="True" Click="OnCancelClick" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
