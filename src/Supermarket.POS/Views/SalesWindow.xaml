<Window x:Class="Supermarket.POS.Views.SalesWindow"
        x:Name="ThisWindow"
        Style="{StaticResource AppWindowStyle}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="نقطة البيع - شاشة البيع"
        Height="900" Width="1500"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="{StaticResource PosBackgroundBrush}">

    <Window.Resources>
        <!-- Product tile of the touch grid -->
        <Style x:Key="ProductTileStyle" TargetType="{x:Type Button}">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Margin" Value="4" />
            <Setter Property="Background" Value="{StaticResource PosPanelBrush}" />
            <Setter Property="Foreground" Value="{StaticResource PosTextBrush}" />
            <Setter Property="MinHeight" Value="96" />
            <Setter Property="Height" Value="Auto" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderBrush" Value="{StaticResource PosBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource PosAccentLightBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Cell padding so text in CartGrid is never clipped or touching borders -->
        <Style TargetType="{x:Type DataGridCell}">
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type DataGridCell}">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="Foreground" Value="White" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ============================== Header ============================== -->
        <Border Grid.Row="0" Background="{StaticResource PosPanelBrush}" CornerRadius="10"
                Padding="16,10" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Text="{Binding StoreName}" FontSize="20" FontWeight="Bold"
                               Foreground="{StaticResource PosAccentBrush}" />
                    <TextBlock Text=" | نقطة البيع" FontSize="15"
                               Foreground="{StaticResource PosMutedTextBrush}" />
                </StackPanel>

                <!-- Shift banner -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
                    <Border Background="{StaticResource PosSuccessLightBrush}" CornerRadius="6" Padding="10,4" Margin="0,0,10,0"
                            Visibility="{Binding IsShiftOpen, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource PosSuccessDarkBrush}">
                            <Run Text="ورديّة مفتوحة:" />
                            <Run Text="{Binding ShiftNumber, Mode=OneWay}" />
                        </TextBlock>
                    </Border>
                    <Border Background="{StaticResource PosDangerLightBrush}" CornerRadius="6" Padding="10,4"
                            Visibility="{Binding IsShiftOpen, Converter={StaticResource BoolToVisibilityInverse}}">
                        <TextBlock Text="لا توجد ورديّة مفتوحة - اضغط على فتح ورديّة"
                                   FontSize="13" Foreground="{StaticResource PosDangerBrush}" />
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <StackPanel Margin="0,0,16,0">
                        <TextBlock Text="{Binding CashierName}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding TerminalId}" FontSize="11"
                                   Foreground="{StaticResource PosMutedTextBrush}" />
                    </StackPanel>
                    <Button Content="فتح ورديّة" Height="38" Width="120" FontSize="13"
                            Command="{Binding OpenShiftCommand}"
                            Visibility="{Binding IsShiftOpen, Converter={StaticResource BoolToVisibilityInverse}}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============================== Body =============================== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <!-- Totals + inline payment + function keys (first column = right-hand side in RTL) -->
                <ColumnDefinition Width="380" />
                <!-- Cart in the middle -->
                <ColumnDefinition Width="*" />
                <!-- Touch tiles on the left -->
                <ColumnDefinition Width="360" />
            </Grid.ColumnDefinitions>

            <!-- ============================ TOTALS & INLINE PAYMENT ============================ -->
            <Grid Grid.Column="0" Margin="0,0,8,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="{StaticResource PosPanelBrush}" CornerRadius="10" Padding="12,10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <!-- Breakdown -->
                            <RowDefinition Height="Auto" />
                            <!-- Separator -->
                            <RowDefinition Height="Auto" />
                            <!-- Grand Total -->
                            <RowDefinition Height="Auto" />
                            <!-- Separator -->
                            <RowDefinition Height="Auto" />
                            <!-- Payment Method -->
                            <RowDefinition Height="Auto" />
                            <!-- Cash details -->
                            <RowDefinition Height="Auto" />
                            <!-- Wallet/Card details -->
                            <RowDefinition Height="Auto" />
                            <!-- Reminder -->
                            <RowDefinition Height="Auto" />
                            <!-- Space filler -->
                            <RowDefinition Height="*" />
                            <!-- Checkout Button -->
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Compact Breakdown: SubTotal | Tax | Discount in 1 neat row -->
                        <Grid Grid.Row="0" Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                <TextBlock Text="المجموع" FontSize="11" Foreground="{StaticResource PosMutedTextBrush}" HorizontalAlignment="Center" />
                                <TextBlock Text="{Binding SubTotalText}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                <TextBlock Text="الضريبة" FontSize="11" Foreground="{StaticResource PosMutedTextBrush}" HorizontalAlignment="Center" />
                                <TextBlock Text="{Binding TaxTotalText}" FontSize="12" Foreground="{StaticResource PosMutedTextBrush}" HorizontalAlignment="Center" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                <TextBlock Text="الخصم" FontSize="11" Foreground="{StaticResource PosMutedTextBrush}" HorizontalAlignment="Center" />
                                <TextBlock Text="{Binding DiscountTotalText}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource PosWarningBrush}" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Grid>

                        <Rectangle Grid.Row="1" Height="1" Fill="{StaticResource PosBorderBrush}" Margin="0,2,0,4" />

                        <!-- Grand Total Display -->
                        <StackPanel Grid.Row="2" HorizontalAlignment="Center" Margin="0,0,0,4">
                            <TextBlock Text="الإجمالي المستحق" FontSize="12"
                                       Foreground="{StaticResource PosMutedTextBrush}"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="{Binding GrandTotalText}"
                                       FontSize="32" FontWeight="Bold"
                                       Foreground="{StaticResource PosAccentBrush}"
                                       HorizontalAlignment="Center" Margin="0,1,0,0" />
                            <TextBlock Text="{Binding ItemCountText}" FontSize="11"
                                       Foreground="{StaticResource PosMutedTextBrush}"
                                       HorizontalAlignment="Center" />
                        </StackPanel>

                        <Rectangle Grid.Row="3" Height="1" Fill="{StaticResource PosBorderBrush}" Margin="0,2,0,4" />

                        <!-- Payment Method Toggle (Cash, Wallet, Card - strictly NO credit/آجل) -->
                        <UniformGrid Grid.Row="4" Columns="3" Margin="0,0,0,4">
                            <Button Content="💵 نقدي" Height="34" Margin="0,0,2,0" FontSize="12"
                                    Command="{Binding SelectPaymentMethodCommand}" CommandParameter="Cash">
                                <Button.Style>
                                    <Style TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
                                        <Setter Property="Background" Value="{StaticResource PosPanelBrush}" />
                                        <Setter Property="Foreground" Value="{StaticResource PosTextBrush}" />
                                        <Setter Property="BorderBrush" Value="{StaticResource PosBorderBrush}" />
                                        <Setter Property="BorderThickness" Value="1" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsCash}" Value="True">
                                                <Setter Property="Background" Value="{StaticResource PosAccentBrush}" />
                                                <Setter Property="Foreground" Value="White" />
                                                <Setter Property="FontWeight" Value="Bold" />
                                                <Setter Property="BorderThickness" Value="0" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>

                            <Button Content="📱 محفظة" Height="34" Margin="2,0,2,0" FontSize="12"
                                    Command="{Binding SelectPaymentMethodCommand}" CommandParameter="Wallet">
                                <Button.Style>
                                    <Style TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
                                        <Setter Property="Background" Value="{StaticResource PosPanelBrush}" />
                                        <Setter Property="Foreground" Value="{StaticResource PosTextBrush}" />
                                        <Setter Property="BorderBrush" Value="{StaticResource PosBorderBrush}" />
                                        <Setter Property="BorderThickness" Value="1" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsWallet}" Value="True">
                                                <Setter Property="Background" Value="{StaticResource PosAccentMidBrush}" />
                                                <Setter Property="Foreground" Value="White" />
                                                <Setter Property="FontWeight" Value="Bold" />
                                                <Setter Property="BorderThickness" Value="0" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>

                            <Button Content="💳 بطاقة" Height="34" Margin="2,0,0,0" FontSize="12"
                                    Command="{Binding SelectPaymentMethodCommand}" CommandParameter="Card">
                                <Button.Style>
                                    <Style TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
                                        <Setter Property="Background" Value="{StaticResource PosPanelBrush}" />
                                        <Setter Property="Foreground" Value="{StaticResource PosTextBrush}" />
                                        <Setter Property="BorderBrush" Value="{StaticResource PosBorderBrush}" />
                                        <Setter Property="BorderThickness" Value="1" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsCard}" Value="True">
                                                <Setter Property="Background" Value="{StaticResource PosAccentDarkBrush}" />
                                                <Setter Property="Foreground" Value="White" />
                                                <Setter Property="FontWeight" Value="Bold" />
                                                <Setter Property="BorderThickness" Value="0" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </UniformGrid>

                        <!-- CASH SECTION: Paid box + Change Banner -->
                        <StackPanel Grid.Row="5" Visibility="{Binding IsCash, Converter={StaticResource BoolToVisibility}}"
                                    Margin="0,0,0,4">
                            <Grid Margin="0,0,0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="المبلغ المدفوع" FontSize="12"
                                           Foreground="{StaticResource PosMutedTextBrush}" VerticalAlignment="Center" />
                                <Button Grid.Column="1" Content="المبلغ بالضبط" Height="24" FontSize="11"
                                        Padding="8,0" Style="{StaticResource PosLightButtonStyle}"
                                        Command="{Binding SetExactPaidCommand}" />
                            </Grid>

                            <TextBox x:Name="PaidAmountBox"
                                     Text="{Binding PaidAmount, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:N2}}"
                                     Height="38" FontSize="20" FontWeight="Bold"
                                     Style="{StaticResource PosLatinInputStyle}"
                                     KeyDown="OnPaidBoxKeyDown"
                                     Margin="0,0,0,4"
                                     ToolTip="أدخل المبلغ المستلم واضغط Enter للإتمام" />

                            <!-- Real-time change banner -->
                            <Border Background="{StaticResource PosSuccessLightBrush}"
                                    BorderBrush="{StaticResource PosSuccessBrush}"
                                    BorderThickness="1" CornerRadius="6" Padding="8,4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="المتبقي (الباقي):"
                                               FontSize="13" FontWeight="SemiBold"
                                               Foreground="{StaticResource PosSuccessDarkBrush}"
                                               VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding ChangeText}"
                                               FontSize="18" FontWeight="Bold"
                                               Foreground="{StaticResource PosSuccessBrush}"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                        </StackPanel>

                        <!-- WALLET / CARD INFO BADGE -->
                        <StackPanel Grid.Row="6">
                            <Border Visibility="{Binding IsWallet, Converter={StaticResource BoolToVisibility}}"
                                    Background="{StaticResource PosAccentLightBrush}"
                                    BorderBrush="{StaticResource PosAccentMidBrush}"
                                    BorderThickness="1" CornerRadius="6" Padding="8,6" Margin="0,0,0,4">
                                <TextBlock Text="📱 الدفع بمحفظة إلكترونية (فودافون كاش / إنستاباي)"
                                           FontSize="12" FontWeight="SemiBold"
                                           Foreground="{StaticResource PosAccentDarkBrush}"
                                           TextWrapping="Wrap" TextAlignment="Center" />
                            </Border>

                            <Border Visibility="{Binding IsCard, Converter={StaticResource BoolToVisibility}}"
                                    Background="{StaticResource PosAccentLightBrush}"
                                    BorderBrush="{StaticResource PosAccentDarkBrush}"
                                    BorderThickness="1" CornerRadius="6" Padding="8,6" Margin="0,0,0,4">
                                <TextBlock Text="💳 الدفع بالبطاقة البنكية (فيزا / ماستركارد / ميزة)"
                                           FontSize="12" FontWeight="SemiBold"
                                           Foreground="{StaticResource PosAccentDarkBrush}"
                                           TextWrapping="Wrap" TextAlignment="Center" />
                            </Border>
                        </StackPanel>

                        <!-- Previous sale change reminder -->
                        <Border Grid.Row="7" Visibility="{Binding LastChangeMessage, Converter={StaticResource EmptyStringToVisibility}}"
                                Background="{StaticResource PosWarningLightBrush}"
                                BorderBrush="{StaticResource PosWarningBrush}"
                                BorderThickness="1" CornerRadius="6" Padding="6,3" Margin="0,0,0,4">
                            <TextBlock Text="{Binding LastChangeMessage}" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{StaticResource PosWarningDarkBrush}"
                                       TextAlignment="Center" TextWrapping="Wrap" />
                        </Border>

                        <!-- Direct Checkout Button (Always visible at bottom) -->
                        <Button Grid.Row="9" Content="💵  إتمام البيع والطباعة (F9)"
                                Height="48" FontSize="18"
                                Background="{StaticResource PosSuccessBrush}"
                                Command="{Binding CheckoutCommand}" />
                    </Grid>
                </Border>

                <!-- ======================== FUNCTION KEYS ======================== -->
                <Border Grid.Row="1" Background="{StaticResource PosPanelBrush}" CornerRadius="10"
                        Padding="4" Margin="0,6,0,0">
                    <UniformGrid Columns="2">
                        <Button Content="F2 بحث" Style="{StaticResource FunctionButtonStyle}"
                                Command="{Binding FocusSearchCommand}" />
                        <Button Content="F3 كمية" Style="{StaticResource FunctionButtonStyle}"
                                Command="{Binding EditQuantityCommand}" />
                        <Button Content="F4 خصم سطر" Style="{StaticResource FunctionButtonStyle}"
                                Command="{Binding EditLineDiscountCommand}" />
                        <Button Content="F7 خصم فاتورة" Style="{StaticResource FunctionButtonStyle}"
                                Command="{Binding EditInvoiceDiscountCommand}" />
                        <Button Content="F8 حذف سطر" Style="{StaticResource FunctionButtonStyle}"
                                Background="{StaticResource PosDangerLightBrush}"
                                Foreground="{StaticResource PosDangerBrush}"
                                Command="{Binding RemoveLineCommand}" />
                        <Button Content="F5 تعليق السلة" Style="{StaticResource FunctionButtonStyle}"
                                Command="{Binding HoldCartCommand}" />
                        <Button Style="{StaticResource FunctionButtonStyle}"
                                Command="{Binding ShowHeldCartsCommand}">
                            <TextBlock>
                                <Run Text="↩ السلات المعلقة" />
                                <Run Text="{Binding HeldCartCount, Mode=OneWay}" FontWeight="Bold" />
                            </TextBlock>
                        </Button>
                        <Button Content="F10 ورديّة" Style="{StaticResource FunctionButtonStyle}"
                                Command="{Binding ShowShiftInfoCommand}" />
                    </UniformGrid>
                </Border>
            </Grid>

            <!-- ============================= CART ============================= -->
            <Grid Grid.Column="1" Margin="0,0,8,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Barcode bar -->
                <Border Grid.Row="0" Background="{StaticResource PosPanelBrush}" CornerRadius="10"
                        Padding="12" Margin="0,0,0,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="البار كود" FontSize="16" Margin="0,0,10,0"
                                   Foreground="{StaticResource PosMutedTextBrush}" />

                        <TextBox x:Name="BarcodeBox" Grid.Column="1"
                                 Style="{StaticResource PosLatinInputStyle}"
                                 Text="{Binding BarcodeBuffer, UpdateSourceTrigger=PropertyChanged}"
                                 Height="58" FontSize="24" FontWeight="SemiBold"
                                 KeyDown="OnBarcodeKeyDown"
                                 ToolTip="امسح البار كود أو اكتبه ثم اضغط Enter" />

                        <Button Grid.Column="2" Content="➕ إضافة" Width="120" Height="58"
                                Margin="10,0,0,0" FontSize="17"
                                Command="{Binding ProcessBarcodeCommand}" />
                    </Grid>
                </Border>

                <!-- Cart grid -->
                <Border Grid.Row="1" Background="{StaticResource PosSurfaceBrush}" CornerRadius="10" Padding="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <DataGrid x:Name="CartGrid" Grid.Row="0"
                                  ItemsSource="{Binding Cart}"
                                  SelectedItem="{Binding SelectedLine}"
                                  RowHeight="44" FontSize="17" BorderThickness="0">
                            <DataGrid.RowStyle>
                                <!-- BasedOn keeps the theme's hover / selection colours. -->
                                <Style TargetType="{x:Type DataGridRow}"
                                       BasedOn="{StaticResource {x:Type DataGridRow}}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ExceedsStock}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource PosDangerLightBrush}" />
                                            <Setter Property="Foreground" Value="{StaticResource PosDangerBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.RowStyle>

                            <DataGrid.Columns>
                                <DataGridTextColumn Header="اسم المنتج" Binding="{Binding ProductName}"
                                                    Width="2*" MinWidth="240">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="VerticalAlignment" Value="Center" />
                                            <Setter Property="Padding" Value="8,0" />
                                            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                            <Setter Property="ToolTip" Value="{Binding ProductName}" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="البار كود" Width="130"
                                                    Binding="{Binding Barcode, Converter={StaticResource RtlIsolation}}" />
                                <DataGridTextColumn Header="الكمية" Width="90"
                                                    Binding="{Binding Quantity, StringFormat={}{0:N2}}" />
                                <DataGridTextColumn Header="الوحدة" Binding="{Binding UnitName}" Width="70" />
                                <DataGridTextColumn Header="سعر الوحدة"
                                                    Binding="{Binding UnitPriceLabel}" Width="110" />
                                <DataGridTextColumn Header="الخصم" Width="90"
                                                    Binding="{Binding DiscountAmount, StringFormat={}{0:N2}}" />
                                <DataGridTextColumn Header="المجموع" Width="130"
                                                    Binding="{Binding LineTotal, StringFormat={}{0:N2} ج.م}" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- Cart toolbar -->
                        <Border Grid.Row="1" Background="{StaticResource PosTableStripeBrush}" Padding="8"
                                CornerRadius="0,0,10,10"
                                BorderBrush="{StaticResource PosBorderBrush}" BorderThickness="0,1,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                    <Button Content="➕" Width="48" Height="44" Margin="0,0,6,0"
                                            Padding="0" FontSize="18"
                                            Style="{StaticResource PosLightButtonStyle}"
                                            Command="{Binding IncreaseQuantityCommand}"
                                            ToolTip="زيادة الكمية (+)" />
                                    <Button Content="➖" Width="48" Height="44" Margin="0,0,8,0"
                                            Padding="0" FontSize="18"
                                            Style="{StaticResource PosLightButtonStyle}"
                                            Command="{Binding DecreaseQuantityCommand}"
                                            ToolTip="تقليل الكمية (-)" />
                                    <Button Content="🗑 حذف السطر" Height="44" Margin="0,0,8,0"
                                            Padding="16,0" FontSize="15"
                                            Background="{StaticResource PosDangerBrush}"
                                            Command="{Binding RemoveLineCommand}"
                                            ToolTip="حذف الصنف المحدد (F8)" />
                                    <Button Content="🧹 تفريغ السلة" Height="44"
                                            Padding="16,0" FontSize="15"
                                            Background="{StaticResource PosWarningBrush}"
                                            Command="{Binding ClearCartCommand}"
                                            ToolTip="تفريغ السلة بالكامل (Esc)" />
                                </StackPanel>

                                <TextBlock Grid.Column="1" Text="{Binding StatusMessage}"
                                           FontSize="14" Foreground="{StaticResource PosTextBrush}"
                                           FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" MaxWidth="420" />
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <!-- =========================== TOUCH PANEL ======================== -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Search -->
                <Border Grid.Row="0" Background="{StaticResource PosPanelBrush}" CornerRadius="10"
                        Padding="10" Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Text="بحث عن منتج" FontSize="13"
                                   Foreground="{StaticResource PosMutedTextBrush}" Margin="0,0,0,6" />
                        <TextBox x:Name="SearchBox"
                                 Text="{Binding SearchTerm, UpdateSourceTrigger=PropertyChanged, Delay=150}"
                                 Height="46" FontSize="17" />
                    </StackPanel>
                </Border>

                <!-- Categories -->
                <Border Grid.Row="1" Background="{StaticResource PosPanelBrush}" CornerRadius="10"
                        Padding="6" Margin="0,0,0,8">
                    <ComboBox ItemsSource="{Binding Categories}"
                              DisplayMemberPath="Name"
                              SelectedItem="{Binding SelectedCategory}"
                              Height="42" FontSize="15" />
                </Border>

                <!-- Product tiles -->
                <Border Grid.Row="2" Background="{StaticResource PosPanelBrush}" CornerRadius="10" Padding="6">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding SearchResults}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="2" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource ProductTileStyle}"
                                            Click="OnProductTileClick"
                                            Command="{Binding DataContext.AddProductCommand, ElementName=ThisWindow}"
                                            CommandParameter="{Binding}">
                                        <StackPanel IsHitTestVisible="False">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13"
                                                       TextWrapping="Wrap" MaxHeight="38" TextTrimming="CharacterEllipsis" />
                                            <TextBlock FontSize="13" FontWeight="Bold" Margin="0,4,0,0"
                                                       Foreground="{StaticResource PosAccentBrush}">
                                                <Run Text="{Binding SellingPrice, Mode=OneWay, StringFormat={}{0:N2}}" />
                                                <Run Text="ج.م" />
                                            </TextBlock>
                                            <TextBlock FontSize="11" Foreground="{StaticResource PosMutedTextBrush}" Margin="0,2,0,0">
                                                <Run Text="المخزون:" />
                                                <Run Text="{Binding StockQuantity, Mode=OneWay, StringFormat={}{0:N2}}" />
                                            </TextBlock>
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Grid>

        <!-- ============================== Footer ============================= -->
        <Border Grid.Row="2" Background="{StaticResource PosPanelBrush}" CornerRadius="10"
                Padding="14,8" Margin="0,8,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="{Binding StatusMessage}" FontSize="15" />

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <TextBlock Text="F1 مساعدة" FontSize="12"
                               Foreground="{StaticResource PosMutedTextBrush}" Margin="0,0,14,0" />
                    <Button Content="🖨 اختبار الطابعة" Width="150" Height="34" FontSize="13"
                            Margin="0,0,8,0" Style="{StaticResource PosLightButtonStyle}"
                            Click="OnTestPrintClick" />
                    <Button Content="F1" Width="60" Height="34" FontSize="13"
                            Command="{Binding ShowHelpCommand}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
