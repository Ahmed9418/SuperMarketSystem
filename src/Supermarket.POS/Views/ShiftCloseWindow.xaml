<Window x:Class="Supermarket.POS.Views.ShiftCloseWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="تقفيل الورديّة"
        Height="820" Width="1180"
        FlowDirection="RightToLeft"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{StaticResource PosBackgroundBrush}">

    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="460" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Grid.ColumnSpan="2" Background="{StaticResource PosPanelBrush}"
                CornerRadius="10" Padding="16,10" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="تقفيل الورديّة" FontSize="20" FontWeight="Bold"
                               Foreground="{StaticResource PosAccentBrush}" />
                    <TextBlock Text="{Binding ShiftSummaryText}" FontSize="13"
                               Foreground="{StaticResource PosMutedTextBrush}" Margin="0,3,0,0" />
                </StackPanel>
                <TextBlock Grid.Column="1" Text="{Binding PrinterStatus}" FontSize="12"
                           Foreground="{StaticResource PosMutedTextBrush}" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!-- ============================ Numbers panel ========================== -->
        <Border Grid.Row="1" Grid.Column="0" Background="{StaticResource PosPanelBrush}"
                CornerRadius="12" Padding="20" Margin="0,0,10,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="ملخص المبيعات" FontSize="15" FontWeight="Bold"
                               Foreground="{StaticResource PosTextBrush}" Margin="0,0,0,8" />

                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="عدد الفواتير" Style="{StaticResource TotalLabelStyle}" />
                        <TextBlock Grid.Column="1" Text="{Binding Report.InvoiceCount}" Style="{StaticResource TotalValueStyle}" />
                    </Grid>

                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="إجمالي المبيعات" Style="{StaticResource TotalLabelStyle}" />
                        <TextBlock Grid.Column="1" Text="{Binding TotalSalesText}" Style="{StaticResource TotalValueStyle}" />
                    </Grid>

                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="مبيعات نقدية" Style="{StaticResource TotalLabelStyle}" />
                        <TextBlock Grid.Column="1" Text="{Binding Report.TotalCashSales, StringFormat={}{0:N2} ج.م}"
                                   Style="{StaticResource TotalValueStyle}" />
                    </Grid>

                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="مبيعات بطاقة" Style="{StaticResource TotalLabelStyle}" />
                        <TextBlock Grid.Column="1" Text="{Binding Report.TotalCardSales, StringFormat={}{0:N2} ج.م}"
                                   Style="{StaticResource TotalValueStyle}" />
                    </Grid>

                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="مبيعات آجلة" Style="{StaticResource TotalLabelStyle}" />
                        <TextBlock Grid.Column="1" Text="{Binding Report.TotalCreditSales, StringFormat={}{0:N2} ج.م}"
                                   Style="{StaticResource TotalValueStyle}" />
                    </Grid>

                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="إجمالي الخصم" Style="{StaticResource TotalLabelStyle}" />
                        <TextBlock Grid.Column="1" Text="{Binding Report.TotalDiscount, StringFormat={}{0:N2} ج.م}"
                                   Style="{StaticResource TotalValueStyle}" Foreground="{StaticResource PosWarningBrush}" />
                    </Grid>

                    <Rectangle Height="1" Fill="{StaticResource PosBorderBrush}" Margin="0,12" />

                    <TextBlock Text="النقدية" FontSize="15" FontWeight="Bold"
                               Foreground="{StaticResource PosTextBrush}" Margin="0,0,0,8" />

                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="النقدية الافتتاحية" Style="{StaticResource TotalLabelStyle}" />
                        <TextBlock Grid.Column="1" Text="{Binding Report.OpeningCash, StringFormat={}{0:N2} ج.م}"
                                   Style="{StaticResource TotalValueStyle}" />
                    </Grid>

                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="النقدية المتوقعة" Style="{StaticResource TotalLabelStyle}" />
                        <TextBlock Grid.Column="1" Text="{Binding ExpectedCashText}" Style="{StaticResource TotalValueStyle}" />
                    </Grid>

                    <TextBlock Text="النقدية المعدودة في الدرج" FontSize="13" Margin="0,10,0,4"
                               Foreground="{StaticResource PosMutedTextBrush}" />
                    <TextBox Text="{Binding ClosingCash, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:N2}}"
                             Height="54" FontSize="24" FontWeight="Bold" IsEnabled="{Binding IsClosed, Converter={StaticResource InverseBool}}" />

                    <Border Background="{StaticResource PosTableStripeBrush}" CornerRadius="8" Padding="14" Margin="0,12,0,0" BorderBrush="{StaticResource PosBorderBrush}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="الفرق" FontSize="13" Foreground="{StaticResource PosMutedTextBrush}" />
                            <TextBlock Text="{Binding DifferenceText}" FontSize="34" FontWeight="Bold"
                                       Foreground="{StaticResource PosAccentBrush}" />
                            <TextBlock Text="{Binding DifferenceVerdict}" FontSize="14"
                                       Foreground="{StaticResource PosWarningBrush}" />
                        </StackPanel>
                    </Border>

                    <TextBlock Text="ملاحظات (اختياري)" FontSize="13" Margin="0,12,0,4"
                               Foreground="{StaticResource PosMutedTextBrush}" />
                    <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"
                             Height="60" AcceptsReturn="True" TextWrapping="Wrap"
                             VerticalContentAlignment="Top" IsEnabled="{Binding IsClosed, Converter={StaticResource InverseBool}}" />

                    <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource PosDangerBrush}" TextWrapping="Wrap"
                               Margin="0,10,0,0" />
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- ============================ Receipt preview ======================== -->
        <Border Grid.Row="1" Grid.Column="1" Background="{StaticResource PosPanelBrush}" CornerRadius="12" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="{StaticResource PosAccentDarkBrush}" Padding="10" CornerRadius="12,12,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="معاينة الإيصال (80 مم)" Foreground="White"
                                   FontWeight="SemiBold" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="تقرير X" Height="34" Width="100" FontSize="13" Margin="0,0,6,0"
                                    Background="{StaticResource PosWarningBrush}"
                                    Command="{Binding ShowXReportCommand}" />
                            <Button Content="تقرير Z" Height="34" Width="100" FontSize="13"
                                    Command="{Binding ShowZReportCommand}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="14">
                    <!-- Monospace, right aligned preview that mirrors the printed layout. -->
                    <TextBlock Text="{Binding PreviewText}"
                               FontFamily="Consolas, Tahoma"
                               FontSize="13"
                               TextWrapping="NoWrap"
                               FlowDirection="LeftToRight"
                               Foreground="{StaticResource PosTextBrush}" />
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- =============================== Footer ============================== -->
        <Grid Grid.Row="2" Grid.ColumnSpan="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <Button Content="🔄 تحديث الأرقام" Height="54" Width="170" FontSize="15"
                        Background="{StaticResource PosPanelBrush}"
                        Command="{Binding RefreshCommand}" />
                <Button Content="🖨 طباعة المعاينة" Height="54" Width="180" FontSize="15" Margin="8,0,0,0"
                        Background="{StaticResource PosPanelBrush}"
                        Command="{Binding PrintPreviewCommand}" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="⏻ تقفيل الورديّة وطباعة Z" Height="54" Width="270" FontSize="17"
                        IsEnabled="{Binding IsClosed, Converter={StaticResource InverseBool}}"
                        Command="{Binding CloseShiftCommand}" />
                <Button Content="إغلاق" Height="54" Width="120" FontSize="15" Margin="8,0,0,0"
                        Background="{StaticResource PosDangerBrush}"
                        Command="{Binding CloseCommand}" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
