<Window x:Class="Supermarket.POS.Views.HeldCartsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Supermarket.POS.ViewModels"
        Title="السلات المعلقة"
        Height="620" Width="820"
        WindowStartupLocation="CenterOwner"
        WindowStyle="ToolWindow"
        ResizeMode="CanResizeWithGrip"
        FlowDirection="RightToLeft"
        Background="{StaticResource PosBackgroundBrush}"
        FontFamily="Tahoma"
        ShowInTaskbar="False">

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ============================== Header ============================== -->
        <Border Grid.Row="0" Background="{StaticResource PosPanelBrush}" CornerRadius="10" Padding="16,12" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="السلات المعلقة" FontSize="22" FontWeight="Bold"
                           Foreground="{StaticResource PosTextBrush}" />
                <TextBlock FontSize="13" Foreground="{StaticResource PosMutedTextBrush}" Margin="0,4,0,0"
                           Text="اختر سلة لاستكمالها. الأسعار تُقرأ من جديد من قاعدة البيانات عند الاستكمال." />
            </StackPanel>
        </Border>

        <!-- ================================ Grid ============================== -->
        <Border Grid.Row="1" Background="{StaticResource PosPanelBrush}" CornerRadius="10" Padding="8">
            <DataGrid x:Name="HeldGrid"
                      ItemsSource="{Binding Carts}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      SelectionMode="Single"
                      FlowDirection="RightToLeft"
                      RowHeight="40"
                      FontSize="14"
                      Background="Transparent"
                      BorderThickness="0"
                      MouseDoubleClick="OnRowDoubleClick">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="البيان" Binding="{Binding Label}" Width="*" />
                    <DataGridTextColumn Header="الكاشير" Binding="{Binding CashierName}" Width="140" />
                    <DataGridTextColumn Header="عدد الأصناف" Binding="{Binding LineCount}" Width="100" />
                    <DataGridTextColumn Header="الكمية" Binding="{Binding TotalQuantity, StringFormat=N2}" Width="90" />
                    <DataGridTextColumn Header="القيمة التقديرية"
                                        Binding="{Binding EstimatedTotal, StringFormat='{}{0:N2}'}"
                                        Width="130" />
                    <DataGridTextColumn Header="وقت التعليق"
                                        Binding="{Binding CreatedAtUtc, StringFormat='{}{0:HH:mm}'}"
                                        Width="110" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- ============================== Footer ============================== -->
        <Border Grid.Row="2" Background="{StaticResource PosPanelBrush}" CornerRadius="10" Padding="12,10" Margin="0,10,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" FontSize="13" VerticalAlignment="Center"
                           Foreground="{StaticResource PosMutedTextBrush}"
                           Text="اضغط مرتين على السلة لاستكمالها، أو استخدم الأزرار." />

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="↩ استكمال السلة" Width="150" Height="44" FontSize="14" Margin="0,0,8,0"
                            Style="{StaticResource FunctionButtonStyle}"
                            Click="OnResumeClick" />
                    <Button Content="🗑 حذف السلة" Width="130" Height="44" FontSize="14" Margin="0,0,8,0"
                            Background="{StaticResource PosDangerBrush}"
                            Click="OnDeleteClick" />
                    <Button Content="إغلاق" Width="100" Height="44" FontSize="14"
                            Click="OnCloseClick" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
