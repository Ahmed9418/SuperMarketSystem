<Application x:Class="Supermarket.POS.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:Supermarket.POS.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Themes/PosTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <converters:BooleanToVisibilityConverter x:Key="BoolToVisibility" />
            <converters:InverseBooleanToVisibilityConverter x:Key="BoolToVisibilityInverse" />
            <converters:EgpCurrencyConverter x:Key="EgpCurrency" />
            <converters:InverseBooleanConverter x:Key="InverseBool" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
