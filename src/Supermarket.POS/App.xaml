<Application x:Class="Supermarket.POS.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Touch theme, then the converters shared with the admin application. -->
                <ResourceDictionary Source="/Themes/PosTheme.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Supermarket.Wpf;component/Themes/Converters.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
